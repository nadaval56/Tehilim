 "verse_count": 18,
 "verses": [
  {
   "v": 1,
   "text": "לֹ֤א לָ֥נוּ ה' לֹ֫א־לָ֥נוּ כִּֽי־לְ֭שִׁמְךָ תֵּ֣ן כָּב֑וֹד עַל־חַ֝סְדְּךָ֗ עַל־אֲמִתֶּֽךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 12,
     "end": 14,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "לָ֭מָּה יֹאמְר֣וּ הַגּוֹיִ֑ם אַיֵּה־נָ֝֗א אֱ-לֹהֵיהֶֽם׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 42,
     "end": 54,
     "prefix": "",
     "suffix": "יהם",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "וֵא-לֹהֵ֥ינוּ בַשָּׁמָ֑יִם כֹּ֖ל אֲשֶׁר־חָפֵ֣ץ עָשָֽׂה׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 13,
     "prefix": "ו",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "עֲֽ֭צַבֵּיהֶם כֶּ֣סֶף וְזָהָ֑ב מַ֝עֲשֵׂ֗ה יְדֵ֣י אָדָֽם׃",
   "names": []
  },
  {
   "v": 5,
   "text": "פֶּֽה־לָ֭הֶם וְלֹ֣א יְדַבֵּ֑רוּ עֵינַ֥יִם לָ֝הֶ֗ם וְלֹ֣א יִרְאֽוּ׃",
   "names": []
  },
  {
   "v": 6,
   "text": "אׇזְנַ֣יִם לָ֭הֶם וְלֹ֣א יִשְׁמָ֑עוּ אַ֥ף לָ֝הֶ֗ם וְלֹ֣א יְרִיחֽוּן׃",
   "names": []
  },
  {
   "v": 7,
   "text": "יְדֵיהֶ֤ם ׀ וְלֹ֬א יְמִישׁ֗וּן רַ֭גְלֵיהֶם וְלֹ֣א יְהַלֵּ֑כוּ לֹא־יֶ֝הְגּ֗וּ בִּגְרוֹנָֽם׃",
   "names": []
  },
  {
   "v": 8,
   "text": "כְּ֭מוֹהֶם יִהְי֣וּ עֹשֵׂיהֶ֑ם כֹּ֖ל אֲשֶׁר־בֹּטֵ֣חַ בָּהֶֽם׃",
   "names": []
  },
  {
   "v": 9,
   "text": "יִ֭שְׂרָאֵל בְּטַ֣ח בַּה' עֶזְרָ֖ם וּמָגִנָּ֣ם הֽוּא׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 20,
     "end": 25,
     "prefix": "ב",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "בֵּ֣ית אַ֭הֲרֹן בִּטְח֣וּ בַה' עֶזְרָ֖ם וּמָגִנָּ֣ם הֽוּא׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 26,
     "end": 30,
     "prefix": "ב",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "יִרְאֵ֣י ה' בִּטְח֣וּ בַה' עֶזְרָ֖ם וּמָגִנָּ֣ם הֽוּא׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 9,
     "end": 11,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 22,
     "end": 26,
     "prefix": "ב",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "ה' זְכָרָ֢נוּ יְבָ֫רֵ֥ךְ יְ֭בָרֵךְ אֶת־בֵּ֣ית יִשְׂרָאֵ֑ל יְ֝בָרֵ֗ךְ אֶת־בֵּ֥ית אַהֲרֹֽן׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "יְ֭בָרֵךְ יִרְאֵ֣י ה' הַ֝קְּטַנִּ֗ים עִם־הַגְּדֹלִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 19,
     "end": 21,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 14,
   "text": "יֹסֵ֣ף ה' עֲלֵיכֶ֑ם עֲ֝לֵיכֶ֗ם וְעַל־בְּנֵיכֶֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 7,
     "end": 9,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "בְּרוּכִ֣ים אַ֭תֶּם לַה' עֹ֝שֵׂ֗ה שָׁמַ֥יִם וָאָֽרֶץ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 20,
     "end": 24,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 16,
   "text": "הַשָּׁמַ֣יִם שָׁ֭מַיִם לַה' וְ֝הָאָ֗רֶץ נָתַ֥ן לִבְנֵי־אָדָֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 23,
     "end": 27,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 17,
   "text": "לֹ֣א הַ֭מֵּתִים יְהַֽלְלוּ־יָ֑הּ וְ֝לֹ֗א כׇּל־יֹרְדֵ֥י דוּמָֽה׃",
   "names": []
  },
  {
   "v": 18,
   "text": "וַאֲנַ֤חְנוּ ׀ נְבָ֘רֵ֤ךְ יָ֗-הּ מֵעַתָּ֥ה וְעַד־עוֹלָ֗ם הַֽלְלוּ־יָֽהּ׃",
   "names": [
    {
     "type": "YAH",
     "word": 2,
     "start": 26,
     "end": 32,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
 ],
