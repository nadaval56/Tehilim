 "verse_count": 23,
 "verses": [
  {
   "v": 1,
   "text": "מִזְמ֗וֹר לְאָ֫סָ֥ף אֵ֤-ל ׀ אֱֽ-לֹהִ֡ים ה' דִּבֶּ֥ר וַיִּקְרָא־אָ֑רֶץ מִמִּזְרַח־שֶׁ֝֗מֶשׁ עַד־מְבֹאֽוֹ׃",
   "names": [
    {
     "type": "EL",
     "word": 2,
     "start": 20,
     "end": 25,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 3,
     "start": 28,
     "end": 39,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 40,
     "end": 42,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "מִצִּיּ֥וֹן מִכְלַל־יֹ֗פִי אֱ-לֹהִ֥ים הוֹפִֽיעַ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 3,
     "start": 27,
     "end": 37,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "יָ֤בֹ֥א אֱ-לֹהֵ֗ינוּ וְֽאַל־יֶ֫חֱרַ֥שׁ אֵשׁ־לְפָנָ֥יו תֹּאכֵ֑ל וּ֝סְבִיבָ֗יו נִשְׂעֲרָ֥ה מְאֹֽד׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 8,
     "end": 20,
     "prefix": "",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "יִקְרָ֣א אֶל־הַשָּׁמַ֣יִם מֵעָ֑ל וְאֶל־הָ֝אָ֗רֶץ לָדִ֥ין עַמּֽוֹ׃",
   "names": []
  },
  {
   "v": 5,
   "text": "אִסְפוּ־לִ֥י חֲסִידָ֑י כֹּרְתֵ֖י בְרִיתִ֣י עֲלֵי־זָֽבַח׃",
   "names": []
  },
  {
   "v": 6,
   "text": "וַיַּגִּ֣ידוּ שָׁמַ֣יִם צִדְק֑וֹ כִּֽי־אֱ-לֹהִ֓ים ׀ שֹׁפֵ֖ט ה֣וּא סֶֽלָה׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 39,
     "end": 49,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "שִׁמְעָ֤ה עַמִּ֨י ׀ וַאֲדַבֵּ֗רָה יִ֭שְׂרָאֵל וְאָעִ֣ידָה בָּ֑ךְ אֱ-לֹהִ֖ים אֱ-לֹהֶ֣יךָ אָנֹֽכִי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 65,
     "end": 75,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 7,
     "start": 76,
     "end": 87,
     "prefix": "",
     "suffix": "יך",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "לֹ֣א עַל־זְ֭בָחֶיךָ אוֹכִיחֶ֑ךָ וְעוֹלֹתֶ֖יךָ לְנֶגְדִּ֣י תָמִֽיד׃",
   "names": []
  },
  {
   "v": 9,
   "text": "לֹא־אֶקַּ֣ח מִבֵּיתְךָ֣ פָ֑ר מִ֝מִּכְלְאֹתֶ֗יךָ עַתּוּדִֽים׃",
   "names": []
  },
  {
   "v": 10,
   "text": "כִּי־לִ֥י כׇל־חַיְתוֹ־יָ֑עַר בְּ֝הֵמ֗וֹת בְּהַרְרֵי־אָֽלֶף׃",
   "names": []
  },
  {
   "v": 11,
   "text": "יָ֭דַעְתִּי כׇּל־ע֣וֹף הָרִ֑ים וְזִ֥יז שָׂ֝דַ֗י עִמָּדִֽי׃",
   "names": []
  },
  {
   "v": 12,
   "text": "אִם־אֶ֭רְעַב לֹא־אֹ֣מַר לָ֑ךְ כִּי־לִ֥י תֵ֝בֵ֗ל וּמְלֹאָֽהּ׃",
   "names": []
  },
  {
   "v": 13,
   "text": "הַ֭אוֹכַל בְּשַׂ֣ר אַבִּירִ֑ים וְדַ֖ם עַתּוּדִ֣ים אֶשְׁתֶּֽה׃",
   "names": []
  },
  {
   "v": 14,
   "text": "זְבַ֣ח לֵא-לֹהִ֣ים תּוֹדָ֑ה וְשַׁלֵּ֖ם לְעֶלְי֣וֹן נְדָרֶֽיךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 7,
     "end": 18,
     "prefix": "ל",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "וּ֭קְרָאֵנִי בְּי֣וֹם צָרָ֑ה אֲ֝חַלֶּצְךָ֗ וּֽתְכַבְּדֵֽנִי׃",
   "names": []
  },
  {
   "v": 16,
   "text": "וְלָ֤רָשָׁ֨ע ׀ אָ֘מַ֤ר אֱ-לֹהִ֗ים מַה־לְּ֭ךָ לְסַפֵּ֣ר חֻקָּ֑י וַתִּשָּׂ֖א בְרִיתִ֣י עֲלֵי־פִֽיךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 23,
     "end": 33,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 17,
   "text": "וְ֭אַתָּה שָׂנֵ֣אתָ מוּסָ֑ר וַתַּשְׁלֵ֖ךְ דְּבָרַ֣י אַחֲרֶֽיךָ׃",
   "names": []
  },
  {
   "v": 18,
   "text": "אִם־רָאִ֣יתָ גַ֭נָּב וַתִּ֣רֶץ עִמּ֑וֹ וְעִ֖ם מְנָאֲפִ֣ים חֶלְקֶֽךָ׃",
   "names": []
  },
  {
   "v": 19,
   "text": "פִּ֭יךָ שָׁלַ֣חְתָּ בְרָעָ֑ה וּ֝לְשׁוֹנְךָ֗ תַּצְמִ֥יד מִרְמָֽה׃",
   "names": []
  },
  {
   "v": 20,
   "text": "תֵּ֭שֵׁב בְּאָחִ֣יךָ תְדַבֵּ֑ר בְּבֶֽן־אִ֝מְּךָ֗ תִּתֶּן־דֹּֽפִי׃",
   "names": []
  },
  {
   "v": 21,
   "text": "אֵ֤לֶּה עָשִׂ֨יתָ ׀ וְֽהֶחֱרַ֗שְׁתִּי דִּמִּ֗יתָ הֱיֽוֹת־אֶהְיֶ֥ה כָמ֑וֹךָ אוֹכִיחֲךָ֖ וְאֶעֶרְכָ֣ה לְעֵינֶֽיךָ׃",
   "names": []
  },
  {
   "v": 22,
   "text": "בִּינוּ־נָ֣א זֹ֭את שֹׁכְחֵ֣י אֱ-ל֑וֹהַּ פֶּן־אֶ֝טְרֹ֗ף וְאֵ֣ין מַצִּֽיל׃",
   "names": [
    {
     "type": "ELOAH",
     "word": 4,
     "start": 29,
     "end": 39,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 23,
   "text": "זֹבֵ֥חַ תּוֹדָ֗ה יְֽכַ֫בְּדָ֥נְנִי וְשָׂ֥ם דֶּ֑רֶךְ אַ֝רְאֶ֗נּוּ בְּיֵ֣שַׁע אֱ-לֹהִֽים׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 7,
     "start": 76,
     "end": 86,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
