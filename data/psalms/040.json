 "verse_count": 18,
 "verses": [
  {
   "v": 1,
   "text": "לַ֝מְנַצֵּ֗חַ לְדָוִ֥ד מִזְמֽוֹר׃",
   "names": []
  },
  {
   "v": 2,
   "text": "קַוֺּ֣ה קִוִּ֣יתִי ה' וַיֵּ֥ט אֵ֝לַ֗י וַיִּשְׁמַ֥ע שַׁוְעָתִֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 19,
     "end": 21,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "וַיַּעֲלֵ֤נִי ׀ מִבּ֥וֹר שָׁאוֹן֮ מִטִּ֢יט הַיָּ֫וֵ֥ן וַיָּ֖קֶם עַל־סֶ֥לַע רַגְלַ֗י כּוֹנֵ֥ן אֲשֻׁרָֽי׃",
   "names": []
  },
  {
   "v": 4,
   "text": "וַיִּתֵּ֬ן בְּפִ֨י ׀ שִׁ֥יר חָדָשׁ֮ תְּהִלָּ֢ה לֵא-לֹ֫הֵ֥ינוּ יִרְא֣וּ רַבִּ֣ים וְיִירָ֑אוּ וְ֝יִבְטְח֗וּ בַּה'׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 47,
     "end": 61,
     "prefix": "ל",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 10,
     "start": 106,
     "end": 111,
     "prefix": "ב",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "אַ֥שְֽׁרֵי־הַגֶּ֗בֶר אֲשֶׁר־שָׂ֣ם ה' מִבְטַח֑וֹ וְֽלֹא־פָנָ֥ה אֶל־רְ֝הָבִ֗ים וְשָׂטֵ֥י כָזָֽב׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 34,
     "end": 36,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "רַבּ֤וֹת עָשִׂ֨יתָ ׀ אַתָּ֤ה ׀ ה' אֱ-לֹהַי֮ נִ֥פְלְאֹתֶ֥יךָ וּמַחְשְׁבֹתֶ֗יךָ אֵ֫לֵ֥ינוּ אֵ֤ין ׀ עֲרֹ֬ךְ אֵלֶ֗יךָ אַגִּ֥ידָה וַאֲדַבֵּ֑רָה עָ֝צְמ֗וּ מִסַּפֵּֽר׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 31,
     "end": 33,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 34,
     "end": 43,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "זֶ֤בַח וּמִנְחָ֨ה ׀ לֹֽא־חָפַ֗צְתָּ אׇ֭זְנַיִם כָּרִ֣יתָ לִּ֑י עוֹלָ֥ה וַ֝חֲטָאָ֗ה לֹ֣א שָׁאָֽלְתָּ׃",
   "names": []
  },
  {
   "v": 8,
   "text": "אָ֣ז אָ֭מַרְתִּי הִנֵּה־בָ֑אתִי בִּמְגִלַּת־סֵ֝֗פֶר כָּת֥וּב עָלָֽי׃",
   "names": []
  },
  {
   "v": 9,
   "text": "לַ֥עֲשׂוֹת־רְצוֹנְךָ֣ אֱ-לֹהַ֣י חָפָ֑צְתִּי וְ֝ת֥וֹרָתְךָ֗ בְּת֣וֹךְ מֵעָֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 22,
     "end": 31,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "בִּשַּׂ֤רְתִּי צֶ֨דֶק ׀ בְּקָ֘הָ֤ל רָ֗ב הִנֵּ֣ה שְׂ֭פָתַי לֹ֣א אֶכְלָ֑א ה' אַתָּ֥ה יָדָֽעְתָּ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 8,
     "start": 72,
     "end": 74,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "צִדְקָתְךָ֬ לֹֽא־כִסִּ֨יתִי ׀ בְּת֬וֹךְ לִבִּ֗י אֱמוּנָתְךָ֣ וּתְשׁוּעָתְךָ֣ אָמָ֑רְתִּי לֹא־כִחַ֥דְתִּי חַסְדְּךָ֥ וַ֝אֲמִתְּךָ֗ לְקָהָ֥ל רָֽב׃",
   "names": []
  },
  {
   "v": 12,
   "text": "אַתָּ֤ה ה' לֹֽא־תִכְלָ֣א רַחֲמֶ֣יךָ מִמֶּ֑נִּי חַסְדְּךָ֥ וַ֝אֲמִתְּךָ֗ תָּמִ֥יד יִצְּרֽוּנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 8,
     "end": 10,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "כִּ֤י אָפְפֽוּ־עָלַ֨י ׀ רָע֡וֹת עַד־אֵ֬ין מִסְפָּ֗ר הִשִּׂיג֣וּנִי עֲ֭וֺנֹתַי וְלֹא־יָכֹ֣לְתִּי לִרְא֑וֹת עָצְמ֥וּ מִשַּׂעֲר֥וֹת רֹ֝אשִׁ֗י וְלִבִּ֥י עֲזָבָֽנִי׃",
   "names": []
  },
  {
   "v": 14,
   "text": "רְצֵ֣ה ה' לְהַצִּילֵ֑נִי ה' לְעֶזְרָ֥תִי חֽוּשָׁה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 7,
     "end": 9,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 25,
     "end": 27,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "יֵ֘בֹ֤שׁוּ וְיַחְפְּר֨וּ ׀ יַחַד֮ מְבַקְשֵׁ֥י נַפְשִׁ֗י לִסְפּ֫וֹתָ֥הּ יִסֹּ֣גוּ אָ֭חוֹר וְיִכָּלְמ֑וּ חֲ֝פֵצֵ֗י רָעָתִֽי׃",
   "names": []
  },
  {
   "v": 16,
   "text": "יָ֭שֹׁמּוּ עַל־עֵ֣קֶב בׇּשְׁתָּ֑ם הָאֹמְרִ֥ים לִ֝֗י הֶ֘אָ֥ח ׀ הֶאָֽח׃",
   "names": []
  },
  {
   "v": 17,
   "text": "יָ֘שִׂ֤ישׂוּ וְיִשְׂמְח֨וּ ׀ בְּךָ֗ כׇּֽל־מְבַ֫קְשֶׁ֥יךָ יֹאמְר֣וּ תָ֭מִיד יִגְדַּ֣ל ה' אֹ֝הֲבֵ֗י תְּשׁוּעָתֶֽךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 8,
     "start": 85,
     "end": 87,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 18,
   "text": "וַאֲנִ֤י ׀ עָנִ֣י וְאֶבְיוֹן֮ אֲ-דֹנָ֢י יַחֲשׇׁ֫ב־לִ֥י עֶזְרָתִ֣י וּמְפַלְטִ֣י אַ֑תָּה אֱ֝-לֹהַ֗י אַל־תְּאַחַֽר׃",
   "names": [
