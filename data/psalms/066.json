 "verse_count": 20,
 "verses": [
  {
   "v": 1,
   "text": "לַ֭מְנַצֵּחַ שִׁ֣יר מִזְמ֑וֹר הָרִ֥יעוּ לֵ֝א-לֹהִ֗ים כׇּל־הָאָֽרֶץ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 40,
     "end": 52,
     "prefix": "ל",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "זַמְּר֥וּ כְבֽוֹד־שְׁמ֑וֹ שִׂ֥ימוּ כָ֝ב֗וֹד תְּהִלָּתֽוֹ׃",
   "names": []
  },
  {
   "v": 3,
   "text": "אִמְר֣וּ לֵ֭א-לֹהִים מַה־נּוֹרָ֣א מַעֲשֶׂ֑יךָ בְּרֹ֥ב עֻ֝זְּךָ֗ יְֽכַחֲשׁ֖וּ לְךָ֣ אֹיְבֶֽיךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 9,
     "end": 20,
     "prefix": "ל",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "כׇּל־הָאָ֤רֶץ ׀ יִשְׁתַּחֲו֣וּ לְ֭ךָ וִיזַמְּרוּ־לָ֑ךְ יְזַמְּר֖וּ שִׁמְךָ֣ סֶֽלָה׃",
   "names": []
  },
  {
   "v": 5,
   "text": "לְכ֣וּ וּ֭רְאוּ מִפְעֲל֣וֹת אֱ-לֹהִ֑ים נוֹרָ֥א עֲ֝לִילָ֗ה עַל־בְּנֵ֥י אָדָֽם׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 3,
     "start": 28,
     "end": 38,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "הָ֤פַךְ יָ֨ם ׀ לְֽיַבָּשָׁ֗ה בַּ֭נָּהָר יַעַבְר֣וּ בְרָ֑גֶל שָׁ֝֗ם נִשְׂמְחָה־בּֽוֹ׃",
   "names": []
  },
  {
   "v": 7,
   "text": "מֹ֘שֵׁ֤ל בִּגְבוּרָת֨וֹ ׀ עוֹלָ֗ם עֵ֭ינָיו בַּגּוֹיִ֣ם תִּצְפֶּ֑ינָה הַסּוֹרְרִ֓ים ׀ אַל־[יָר֖וּמוּ] (ירימו) לָ֣מוֹ סֶֽלָה׃",
   "names": []
  },
  {
   "v": 8,
   "text": "בָּרְכ֖וּ עַמִּ֥ים ׀ אֱ-לֹהֵ֑ינוּ וְ֝הַשְׁמִ֗יעוּ ק֣וֹל תְּהִלָּתֽוֹ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 21,
     "end": 33,
     "prefix": "",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "הַשָּׂ֣ם נַ֭פְשֵׁנוּ בַּחַיִּ֑ים וְלֹֽא־נָתַ֖ן לַמּ֣וֹט רַגְלֵֽנוּ׃",
   "names": []
  },
  {
   "v": 10,
   "text": "כִּֽי־בְחַנְתָּ֥נוּ אֱ-לֹהִ֑ים צְ֝רַפְתָּ֗נוּ כִּצְרׇף־כָּֽסֶף׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 20,
     "end": 30,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "הֲבֵאתָ֥נוּ בַמְּצוּדָ֑ה שַׂ֖מְתָּ מוּעָקָ֣ה בְמׇתְנֵֽינוּ׃",
   "names": []
  },
  {
   "v": 12,
   "text": "הִרְכַּ֥בְתָּֽ אֱנ֗וֹשׁ לְרֹ֫אשֵׁ֥נוּ בָּֽאנוּ־בָאֵ֥שׁ וּבַמַּ֑יִם וַ֝תּוֹצִיאֵ֗נוּ לָרְוָיָֽה׃",
   "names": []
  },
  {
   "v": 13,
   "text": "אָב֣וֹא בֵיתְךָ֣ בְעוֹל֑וֹת אֲשַׁלֵּ֖ם לְךָ֣ נְדָרָֽי׃",
   "names": []
  },
  {
   "v": 14,
   "text": "אֲשֶׁר־פָּצ֥וּ שְׂפָתָ֑י וְדִבֶּר־פִּ֝֗י בַּצַּר־לִֽי׃",
   "names": []
  },
  {
   "v": 15,
   "text": "עֹ֘ל֤וֹת מֵיחִ֣ים אַֽעֲלֶה־לָּ֭ךְ עִם־קְטֹ֣רֶת אֵילִ֑ים אֶ֥עֱשֶֽׂה־בָקָ֖ר עִם־עַתּוּדִ֣ים סֶֽלָה׃",
   "names": []
  },
  {
   "v": 16,
   "text": "לְכוּ־שִׁמְע֣וּ וַ֭אֲסַפְּרָה כׇּל־יִרְאֵ֣י אֱ-לֹהִ֑ים אֲשֶׁ֖ר עָשָׂ֣ה לְנַפְשִֽׁי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 44,
     "end": 54,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 17,
   "text": "אֵלָ֥יו פִּֽי־קָרָ֑אתִי וְ֝רוֹמַ֗ם תַּ֣חַת לְשׁוֹנִֽי׃",
   "names": []
  },
  {
   "v": 18,
   "text": "אָ֭וֶן אִם־רָאִ֣יתִי בְלִבִּ֑י לֹ֖א יִשְׁמַ֣ע ׀ אֲ-דֹנָֽי׃",
   "names": [
    {
     "type": "ADNI",
     "word": 6,
     "start": 48,
     "end": 57,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 19,
   "text": "אָ֭כֵן שָׁמַ֣ע אֱ-לֹהִ֑ים הִ֝קְשִׁ֗יב בְּק֣וֹל תְּפִלָּתִֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 15,
     "end": 25,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 20,
   "text": "בָּר֥וּךְ אֱ-לֹהִ֑ים אֲשֶׁ֥ר לֹֽא־הֵסִ֘יר־תְּפִלָּתִ֥י וְ֝חַסְדּ֗וֹ מֵאִתִּֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 10,
     "end": 20,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
 ],
