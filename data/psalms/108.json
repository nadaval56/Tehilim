 "verse_count": 14,
 "verses": [
  {
   "v": 1,
   "text": "שִׁ֖יר מִזְמ֣וֹר לְדָוִֽד׃",
   "names": []
  },
  {
   "v": 2,
   "text": "נָכ֣וֹן לִבִּ֣י אֱ-לֹהִ֑ים אָשִׁ֥ירָה וַ֝אֲזַמְּרָ֗ה אַף־כְּבוֹדִֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 16,
     "end": 26,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "ע֭וּרָֽה הַנֵּ֥בֶל וְכִנּ֗וֹר אָעִ֥ירָה שָּֽׁחַר׃",
   "names": []
  },
  {
   "v": 4,
   "text": "אוֹדְךָ֖ בָעַמִּ֥ים ׀ ה' וַ֝אֲזַמֶּרְךָ֗ בַּלְאֻמִּֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 22,
     "end": 24,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "כִּי־גָד֣וֹל מֵעַל־שָׁמַ֣יִם חַסְדֶּ֑ךָ וְֽעַד־שְׁחָקִ֥ים אֲמִתֶּֽךָ׃",
   "names": []
  },
  {
   "v": 6,
   "text": "ר֣וּמָה עַל־שָׁמַ֣יִם אֱ-לֹהִ֑ים וְעַ֖ל כׇּל־הָאָ֣רֶץ כְּבוֹדֶֽךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 3,
     "start": 22,
     "end": 32,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "לְ֭מַעַן יֵחָלְצ֣וּן יְדִידֶ֑יךָ הוֹשִׁ֖יעָה יְמִֽינְךָ֣ וַעֲנֵֽנִי׃",
   "names": []
  },
  {
   "v": 8,
   "text": "אֱ-לֹהִ֤ים ׀ דִּבֶּ֥ר בְּקׇדְשׁ֗וֹ אֶ֫עְלֹ֥זָה אֲחַלְּקָ֥ה שְׁכֶ֑ם וְעֵ֖מֶק סֻכּ֣וֹת אֲמַדֵּֽד׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 10,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "לִ֤י גִלְעָ֨ד ׀ לִ֤י מְנַשֶּׁ֗ה וְ֭אֶפְרַיִם מָע֣וֹז רֹאשִׁ֑י יְ֝הוּדָ֗ה מְחֹקְקִֽי׃",
   "names": []
  },
  {
   "v": 10,
   "text": "מוֹאָ֤ב ׀ סִ֬יר רַחְצִ֗י עַל־אֱ֭דוֹם אַשְׁלִ֣יךְ נַעֲלִ֑י עֲלֵי־פְ֝לֶ֗שֶׁת אֶתְרוֹעָֽע׃",
   "names": []
  },
  {
   "v": 11,
   "text": "מִ֣י יֹ֭בִלֵנִי עִ֣יר מִבְצָ֑ר מִ֖י נָחַ֣נִי עַד־אֱדֽוֹם׃",
   "names": []
  },
  {
   "v": 12,
   "text": "הֲלֹֽא־אֱ-לֹהִ֥ים זְנַחְתָּ֑נוּ וְֽלֹא־תֵצֵ֥א אֱ֝-לֹהִ֗ים בְּצִבְאֹתֵֽינוּ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 7,
     "end": 17,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 46,
     "end": 57,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "הָבָה־לָּ֣נוּ עֶזְרָ֣ת מִצָּ֑ר וְ֝שָׁ֗וְא תְּשׁוּעַ֥ת אָדָֽם׃",
   "names": []
  },
  {
   "v": 14,
   "text": "בֵּא-לֹהִ֥ים נַֽעֲשֶׂה־חָ֑יִל וְ֝ה֗וּא יָב֥וּס צָרֵֽינוּ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 12,
     "prefix": "ב",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
 ],
