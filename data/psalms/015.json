 "verses": [
  {
   "v": 1,
   "text": "מִזְמ֗וֹר לְדָ֫וִ֥ד ה' מִי־יָג֣וּר בְּאׇהֳלֶ֑ךָ מִֽי־יִ֝שְׁכֹּ֗ן בְּהַ֣ר קׇדְשֶֽׁךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 20,
     "end": 22,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "הוֹלֵ֣ךְ תָּ֭מִים וּפֹעֵ֥ל צֶ֑דֶק וְדֹבֵ֥ר אֱ֝מֶ֗ת בִּלְבָבֽוֹ׃",
   "names": []
  },
  {
   "v": 3,
   "text": "לֹֽא־רָגַ֨ל ׀ עַל־לְשֹׁנ֗וֹ לֹא־עָשָׂ֣ה לְרֵעֵ֣הוּ רָעָ֑ה וְ֝חֶרְפָּ֗ה לֹא־נָשָׂ֥א עַל־קְרֹבֽוֹ׃",
   "names": []
  },
  {
   "v": 4,
   "text": "נִבְזֶ֤ה ׀ בְּֽעֵ֘ינָ֤יו נִמְאָ֗ס וְאֶת־יִרְאֵ֣י ה' יְכַבֵּ֑ד נִשְׁבַּ֥ע לְ֝הָרַ֗ע וְלֹ֣א יָמִֽר׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 49,
     "end": 51,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "כַּסְפּ֤וֹ ׀ לֹא־נָתַ֣ן בְּנֶשֶׁךְ֮ וְשֹׁ֥חַד עַל־נָקִ֗י לֹ֥א־לָ֫קָ֥ח עֹֽשֵׂה־אֵ֑לֶּה לֹ֖א יִמּ֣וֹט לְעוֹלָֽם׃",
   "names": []
  }
 ],
