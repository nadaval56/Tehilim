 "verses": [
  {
   "v": 1,
   "text": "שִׁ֖יר מִזְמ֣וֹר לְאָסָֽף׃",
   "names": []
  },
  {
   "v": 2,
   "text": "אֱ-לֹהִ֥ים אַל־דֳּמִי־לָ֑ךְ אַל־תֶּחֱרַ֖שׁ וְאַל־תִּשְׁקֹ֣ט אֵֽ-ל׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 10,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 8,
     "start": 60,
     "end": 65,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "כִּֽי־הִנֵּ֣ה א֭וֹיְבֶיךָ יֶהֱמָי֑וּן וּ֝מְשַׂנְאֶ֗יךָ נָ֣שְׂאוּ רֹֽאשׁ׃",
   "names": []
  },
  {
   "v": 4,
   "text": "עַֽל־עַ֭מְּךָ יַעֲרִ֣ימוּ ס֑וֹד וְ֝יִתְיָעֲצ֗וּ עַל־צְפוּנֶֽיךָ׃",
   "names": []
  },
  {
   "v": 5,
   "text": "אָמְר֗וּ לְ֭כוּ וְנַכְחִידֵ֣ם מִגּ֑וֹי וְלֹֽא־יִזָּכֵ֖ר שֵֽׁם־יִשְׂרָאֵ֣ל עֽוֹד׃",
   "names": []
  },
  {
   "v": 6,
   "text": "כִּ֤י נוֹעֲצ֣וּ לֵ֣ב יַחְדָּ֑ו עָ֝לֶ֗יךָ בְּרִ֣ית יִכְרֹֽתוּ׃",
   "names": []
  },
  {
   "v": 7,
   "text": "אׇהֳלֵ֣י אֱ֭דוֹם וְיִשְׁמְעֵאלִ֗ים מוֹאָ֥ב וְהַגְרִֽים׃",
   "names": []
  },
  {
   "v": 8,
   "text": "גְּבָ֣ל וְ֭עַמּוֹן וַעֲמָלֵ֑ק פְּ֝לֶ֗שֶׁת עִם־יֹ֥שְׁבֵי צֽוֹר׃",
   "names": []
  },
  {
   "v": 9,
   "text": "גַּם־אַ֭שּׁוּר נִלְוָ֣ה עִמָּ֑ם הָ֤יֽוּ־זְר֖וֹעַ לִבְנֵי־ל֣וֹט סֶֽלָה׃",
   "names": []
  },
  {
   "v": 10,
   "text": "עֲשֵֽׂה־לָהֶ֥ם כְּמִדְיָ֑ן כְּֽסִיסְרָ֥א כְ֝יָבִ֗ין בְּנַ֣חַל קִישֽׁוֹן׃",
   "names": []
  },
  {
   "v": 11,
   "text": "נִשְׁמְד֥וּ בְֽעֵין־דֹּ֑אר הָ֥יוּ דֹ֝֗מֶן לָאֲדָמָֽה׃",
   "names": []
  },
  {
   "v": 12,
   "text": "שִׁיתֵ֣מוֹ נְ֭דִיבֵימוֹ כְּעֹרֵ֣ב וְכִזְאֵ֑ב וּֽכְזֶ֥בַח וּ֝כְצַלְמֻנָּ֗ע כׇּל־נְסִיכֵֽימוֹ׃",
   "names": []
  },
  {
   "v": 13,
   "text": "אֲשֶׁ֣ר אָ֭מְרוּ נִ֣ירְשָׁה לָּ֑נוּ אֵ֝֗ת נְא֣וֹת אֱ-לֹהִֽים׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 50,
     "end": 60,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 14,
   "text": "אֱֽ-לֹהַ֗י שִׁיתֵ֥מוֹ כַגַּלְגַּ֑ל כְּ֝קַ֗שׁ לִפְנֵי־רֽוּחַ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 10,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "כְּאֵ֥שׁ תִּבְעַר־יָ֑עַר וּ֝כְלֶהָבָ֗ה תְּלַהֵ֥ט הָרִֽים׃",
   "names": []
  },
  {
   "v": 16,
   "text": "כֵּ֭ן תִּרְדְּפֵ֣ם בְּסַעֲרֶ֑ךָ וּבְסוּפָתְךָ֥ תְבַהֲלֵֽם׃",
   "names": []
  },
  {
   "v": 17,
   "text": "מַלֵּ֣א פְנֵיהֶ֣ם קָל֑וֹן וִיבַקְשׁ֖וּ שִׁמְךָ֣ ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 48,
     "end": 50,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 18,
   "text": "יֵבֹ֖שׁוּ וְיִבָּהֲל֥וּ עֲדֵי־עַ֗ד וְֽיַחְפְּר֥וּ וְיֹאבֵֽדוּ׃",
   "names": []
  },
  {
   "v": 19,
   "text": "וְֽיֵדְע֗וּ כִּי־אַתָּ֬ה שִׁמְךָ֣ ה' לְבַדֶּ֑ךָ עֶ֝לְי֗וֹן עַל־כׇּל־הָאָֽרֶץ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 34,
     "end": 36,
     "prefix": "",
