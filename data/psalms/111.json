 "verse_count": 10,
 "verses": [
  {
   "v": 1,
   "text": "הַ֥לְלוּ־יָ֨הּ ׀ אוֹדֶ֣ה ה' בְּכׇל־לֵבָ֑ב בְּס֖וֹד יְשָׁרִ֣ים וְעֵדָֽה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 25,
     "end": 27,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "גְּ֭דֹלִים מַעֲשֵׂ֣י ה' דְּ֝רוּשִׁ֗ים לְכׇל־חֶפְצֵיהֶֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 21,
     "end": 23,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "הוֹד־וְהָדָ֥ר פׇּעֳל֑וֹ וְ֝צִדְקָת֗וֹ עֹמֶ֥דֶת לָעַֽד׃",
   "names": []
  },
  {
   "v": 4,
   "text": "זֵ֣כֶר עָ֭שָׂה לְנִפְלְאוֹתָ֑יו חַנּ֖וּן וְרַח֣וּם ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 51,
     "end": 53,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "טֶ֭רֶף נָתַ֣ן לִירֵאָ֑יו יִזְכֹּ֖ר לְעוֹלָ֣ם בְּרִיתֽוֹ׃",
   "names": []
  },
  {
   "v": 6,
   "text": "כֹּ֣חַ מַ֭עֲשָׂיו הִגִּ֣יד לְעַמּ֑וֹ לָתֵ֥ת לָ֝הֶ֗ם נַחֲלַ֥ת גּוֹיִֽם׃",
   "names": []
  },
  {
   "v": 7,
   "text": "מַעֲשֵׂ֣י יָ֭דָיו אֱמֶ֣ת וּמִשְׁפָּ֑ט נֶ֝אֱמָנִ֗ים כׇּל־פִּקּוּדָֽיו׃",
   "names": []
  },
  {
   "v": 8,
   "text": "סְמוּכִ֣ים לָעַ֣ד לְעוֹלָ֑ם עֲ֝שׂוּיִ֗ם בֶּאֱמֶ֥ת וְיָשָֽׁר׃",
   "names": []
  },
  {
   "v": 9,
   "text": "פְּד֤וּת ׀ שָׁ֘לַ֤ח לְעַמּ֗וֹ צִוָּֽה־לְעוֹלָ֥ם בְּרִית֑וֹ קָד֖וֹשׁ וְנוֹרָ֣א שְׁמֽוֹ׃",
   "names": []
  },
  {
   "v": 10,
   "text": "רֵ֘אשִׁ֤ית חׇכְמָ֨ה ׀ יִרְאַ֬ת ה' שֵׂ֣כֶל ט֭וֹב לְכׇל־עֹֽשֵׂיהֶ֑ם תְּ֝הִלָּת֗וֹ עֹמֶ֥דֶת לָעַֽד׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 31,
     "end": 33,
     "prefix": "",
     "suffix": "",
     "chol": false,
