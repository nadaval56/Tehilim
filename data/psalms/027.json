 "verse_count": 14,
 "verses": [
  {
   "v": 1,
   "text": "לְדָוִ֨ד ׀ ה' ׀ אוֹרִ֣י וְ֭יִשְׁעִי מִמִּ֣י אִירָ֑א ה' מָעוֹז־חַ֝יַּ֗י מִמִּ֥י אֶפְחָֽד׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 11,
     "end": 13,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 6,
     "start": 52,
     "end": 54,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "בִּקְרֹ֤ב עָלַ֨י ׀ מְרֵעִים֮ לֶאֱכֹ֢ל אֶת־בְּשָׂ֫רִ֥י צָרַ֣י וְאֹיְבַ֣י לִ֑י הֵ֖מָּה כָשְׁל֣וּ וְנָפָֽלוּ׃",
   "names": []
  },
  {
   "v": 3,
   "text": "אִם־תַּחֲנֶ֬ה עָלַ֨י ׀ מַחֲנֶה֮ לֹא־יִירָ֢א לִ֫בִּ֥י אִם־תָּק֣וּם עָ֭לַי מִלְחָמָ֑ה בְּ֝זֹ֗את אֲנִ֣י בוֹטֵֽחַ׃",
   "names": []
  },
  {
   "v": 4,
   "text": "אַחַ֤ת ׀ שָׁאַ֣לְתִּי מֵאֵת־ה' אוֹתָ֢הּ אֲבַ֫קֵּ֥שׁ שִׁבְתִּ֣י בְּבֵית־ה' כׇּל־יְמֵ֣י חַיַּ֑י לַחֲז֥וֹת בְּנֹעַם־ה' וּלְבַקֵּ֥ר בְּהֵֽיכָלֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 28,
     "end": 30,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 8,
     "start": 71,
     "end": 73,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 14,
     "start": 113,
     "end": 115,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "כִּ֤י יִצְפְּנֵ֨נִי ׀ בְּסֻכֹּה֮ בְּי֢וֹם רָ֫עָ֥ה יַ֭סְתִּרֵנִי בְּסֵ֣תֶר אׇהֳל֑וֹ בְּ֝צ֗וּר יְרוֹמְמֵֽנִי׃",
   "names": []
  },
  {
   "v": 6,
   "text": "וְעַתָּ֨ה יָר֪וּם רֹאשִׁ֡י עַ֤ל אֹיְבַ֬י סְֽבִיבוֹתַ֗י וְאֶזְבְּחָ֣ה בְ֭אׇהֳלוֹ זִבְחֵ֣י תְרוּעָ֑ה אָשִׁ֥ירָה וַ֝אֲזַמְּרָ֗ה לַֽה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 12,
     "start": 125,
     "end": 130,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "שְׁמַע־ה' קוֹלִ֥י אֶקְרָ֗א וְחׇנֵּ֥נִי וַעֲנֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 7,
     "end": 9,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "לְךָ֤ ׀ אָמַ֣ר לִ֭בִּי בַּקְּשׁ֣וּ פָנָ֑י אֶת־פָּנֶ֖יךָ ה' אֲבַקֵּֽשׁ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 56,
     "end": 58,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "אַל־תַּסְתֵּ֬ר פָּנֶ֨יךָ ׀ מִמֶּנִּי֮ אַ֥ל תַּט־בְּאַ֗ף עַ֫בְדֶּ֥ךָ עֶזְרָתִ֥י הָיִ֑יתָ אַֽל־תִּטְּשֵׁ֥נִי וְאַל־תַּ֝עַזְבֵ֗נִי אֱ-לֹהֵ֥י יִשְׁעִֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 14,
     "start": 128,
     "end": 137,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "כִּֽי־אָבִ֣י וְאִמִּ֣י עֲזָב֑וּנִי וַֽה' יַאַסְפֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 35,
     "end": 40,
     "prefix": "ו",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "ה֤וֹרֵ֥נִי ה' דַּ֫רְכֶּ֥ךָ וּ֭נְחֵנִי בְּאֹ֣רַח מִישׁ֑וֹר לְ֝מַ֗עַן שֽׁוֹרְרָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 11,
     "end": 13,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "אַֽל־תִּ֭תְּנֵנִי בְּנֶ֣פֶשׁ צָרָ֑י כִּ֥י קָמוּ־בִ֥י עֵדֵי־שֶׁ֝֗קֶר וִיפֵ֥חַ חָמָֽס׃",
   "names": []
  },
  {
   "v": 13,
   "text": "לׅׄוּׅׄלֵׅ֗ׄאׅׄ הֶ֭אֱמַנְתִּי לִרְא֥וֹת בְּֽטוּב־ה' בְּאֶ֣רֶץ חַיִּֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 49,
     "end": 51,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 14,
   "text": "קַוֵּ֗ה אֶל־ה' חֲ֭זַק וְיַאֲמֵ֣ץ לִבֶּ֑ךָ וְ֝קַוֵּ֗ה אֶל־ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 12,
     "end": 14,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
