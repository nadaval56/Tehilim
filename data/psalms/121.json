 "verse_count": 8,
 "verses": [
  {
   "v": 1,
   "text": "שִׁ֗יר לַֽמַּ֫עֲל֥וֹת אֶשָּׂ֣א עֵ֭ינַי אֶל־הֶהָרִ֑ים מֵ֝אַ֗יִן יָבֹ֥א עֶזְרִֽי׃",
   "names": []
  },
  {
   "v": 2,
   "text": "עֶ֭זְרִי מֵעִ֣ם ה' עֹ֝שֵׂ֗ה שָׁמַ֥יִם וָאָֽרֶץ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 16,
     "end": 18,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "אַל־יִתֵּ֣ן לַמּ֣וֹט רַגְלֶ֑ךָ אַל־יָ֝נ֗וּם שֹׁמְרֶֽךָ׃",
   "names": []
  },
  {
   "v": 4,
   "text": "הִנֵּ֣ה לֹֽא־יָ֭נוּם וְלֹ֣א יִישָׁ֑ן שׁ֝וֹמֵ֗ר יִשְׂרָאֵֽל׃",
   "names": []
  },
  {
   "v": 5,
   "text": "ה' שֹׁמְרֶ֑ךָ ה' צִ֝לְּךָ֗ עַל־יַ֥ד יְמִינֶֽךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 14,
     "end": 16,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "יוֹמָ֗ם הַשֶּׁ֥מֶשׁ לֹֽא־יַכֶּ֗כָּה וְיָרֵ֥חַ בַּלָּֽיְלָה׃",
   "names": []
  },
  {
   "v": 7,
   "text": "ה' יִשְׁמׇרְךָ֥ מִכׇּל־רָ֑ע יִ֝שְׁמֹ֗ר אֶת־נַפְשֶֽׁךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "ה' יִשְׁמׇר־צֵאתְךָ֥ וּבוֹאֶ֑ךָ מֵ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
 ],
