 "verse_count": 10,
 "verses": [
  {
   "v": 1,
   "text": "לְדָוִ֗ד מִ֫זְמ֥וֹר לַֽ֭ה' הָאָ֣רֶץ וּמְלוֹאָ֑הּ תֵּ֝בֵ֗ל וְיֹ֣שְׁבֵי בָֽהּ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 20,
     "end": 26,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "כִּי־ה֭וּא עַל־יַמִּ֣ים יְסָדָ֑הּ וְעַל־נְ֝הָר֗וֹת יְכוֹנְנֶֽהָ׃",
   "names": []
  },
  {
   "v": 3,
   "text": "מִֽי־יַעֲלֶ֥ה בְהַר־ה' וּמִי־יָ֝ק֗וּם בִּמְק֥וֹם קׇדְשֽׁוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 20,
     "end": 22,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "נְקִ֥י כַפַּ֗יִם וּֽבַר־לֵ֫בָ֥ב אֲשֶׁ֤ר ׀ לֹא־נָשָׂ֣א לַשָּׁ֣וְא נַפְשִׁ֑י וְלֹ֖א נִשְׁבַּ֣ע לְמִרְמָֽה׃",
   "names": []
  },
  {
   "v": 5,
   "text": "יִשָּׂ֣א בְ֭רָכָה מֵאֵ֣ת ה' וּ֝צְדָקָ֗ה מֵאֱ-לֹהֵ֥י יִשְׁעֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 25,
     "end": 27,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 40,
     "end": 51,
     "prefix": "מ",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "זֶ֭ה דּ֣וֹר דֹּרְשָׁ֑ו מְבַקְשֵׁ֨י פָנֶ֖יךָ יַעֲקֹ֣ב סֶֽלָה׃",
   "names": []
  },
  {
   "v": 7,
   "text": "שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם וְֽ֭הִנָּשְׂאוּ פִּתְחֵ֣י עוֹלָ֑ם וְ֝יָב֗וֹא מֶ֣לֶךְ הַכָּבֽוֹד׃",
   "names": []
  },
  {
   "v": 8,
   "text": "מִ֥י זֶה֮ מֶ֤לֶךְ הַכָּ֫ב֥וֹד ה' עִזּ֣וּז וְגִבּ֑וֹר ה' גִּבּ֥וֹר מִלְחָמָֽה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 30,
     "end": 32,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 53,
     "end": 55,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "שְׂא֤וּ שְׁעָרִ֨ים ׀ רָֽאשֵׁיכֶ֗ם וּ֭שְׂאוּ פִּתְחֵ֣י עוֹלָ֑ם וְ֝יָבֹ֗א מֶ֣לֶךְ הַכָּבֽוֹד׃",
   "names": []
  },
  {
   "v": 10,
   "text": "מִ֤י־ה֣וּא זֶה֮ מֶ֤לֶךְ הַכָּ֫ב֥וֹד ה' צְ-בָא֑וֹת ה֤וּא מֶ֖לֶךְ הַכָּב֣וֹד סֶֽלָה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 36,
     "end": 38,
     "prefix": "",
     "suffix": "",
     "chol": false,
