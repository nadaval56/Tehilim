     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "אוֹמְרָ֤ה ׀ לְאֵ֥-ל סַלְעִי֮ לָמָ֢ה שְׁכַ֫חְתָּ֥נִי לָֽמָּה־קֹדֵ֥ר אֵלֵ֗ךְ בְּלַ֣חַץ אוֹיֵֽב׃",
   "names": [
    {
     "type": "EL",
     "word": 1,
     "start": 12,
     "end": 19,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
