   ]
  },
  {
   "v": 7,
   "text": "יָשׁ֣וּבוּ לָ֭עֶרֶב יֶהֱמ֥וּ כַכָּ֗לֶב וִיס֥וֹבְבוּ עִֽיר׃",
   "names": []
  },
  {
   "v": 8,
   "text": "הִנֵּ֤ה ׀ יַבִּ֘יע֤וּן בְּפִיהֶ֗ם חֲ֭רָבוֹת בְּשִׂפְתֽוֹתֵיהֶ֑ם כִּי־מִ֥י שֹׁמֵֽעַ׃",
   "names": []
  },
  {
   "v": 9,
   "text": "וְאַתָּ֣ה ה' תִּשְׂחַק־לָ֑מוֹ תִּ֝לְעַ֗ג לְכׇל־גּוֹיִֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "עֻ֭זּוֹ אֵלֶ֣יךָ אֶשְׁמֹ֑רָה כִּֽי־אֱ֝-לֹהִ֗ים מִשְׂגַּבִּֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 35,
     "end": 46,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
