     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "אֱ-לֹהֵ֣י (חסדו) [חַסְדִּ֣י] יְקַדְּמֵ֑נִי אֱ֝-לֹהִ֗ים יַרְאֵ֥נִי בְשֹׁרְרָֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 9,
     "prefix": "",
     "suffix": "י",
     "chol": false,
