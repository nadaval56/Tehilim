   "v": 1,
   "text": "מִזְמ֗וֹר לְאָ֫סָ֥ף אֱֽ-לֹהִ֗ים נִצָּ֥ב בַּעֲדַת־אֵ֑-ל בְּקֶ֖רֶב אֱ-לֹהִ֣ים יִשְׁפֹּֽט׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 20,
     "end": 31,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
