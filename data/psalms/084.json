    }
   ]
  },
  {
   "v": 4,
   "text": "גַּם־צִפּ֨וֹר מָ֪צְאָה בַ֡יִת וּדְר֤וֹר ׀ קֵ֥ן לָהּ֮ אֲשֶׁר־שָׁ֢תָה אֶפְרֹ֫חֶ֥יהָ אֶֽת־מִ֭זְבְּחוֹתֶיךָ ה' צְ-בָא֑וֹת מַ֝לְכִּ֗י וֵא-לֹהָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 12,
     "start": 104,
     "end": 106,
     "prefix": "",
     "suffix": "",
     "chol": false,
