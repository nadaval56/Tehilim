  {
   "v": 126,
   "text": "עֵ֭ת לַעֲשׂ֣וֹת לַה' הֵ֝פֵ֗רוּ תּוֹרָתֶֽךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 16,
     "end": 20,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 127,
   "text": "עַל־כֵּ֭ן אָהַ֣בְתִּי מִצְוֺתֶ֑יךָ מִזָּהָ֥ב וּמִפָּֽז׃",
   "names": []
  },
  {
   "v": 128,
   "text": "עַל־כֵּ֤ן ׀ כׇּל־פִּקּ֣וּדֵי כֹ֣ל יִשָּׁ֑רְתִּי כׇּל־אֹ֖רַח שֶׁ֣קֶר שָׂנֵֽאתִי׃",
   "names": []
  },
  {
   "v": 129,
   "text": "פְּלָא֥וֹת עֵדְוֺתֶ֑יךָ עַל־כֵּ֝֗ן נְצָרָ֥תַם נַפְשִֽׁי׃",
   "names": []
  },
  {
   "v": 130,
   "text": "פֵּ֖תַח דְּבָרֶ֥יךָ יָאִ֗יר מֵבִ֥ין פְּתָיִֽים׃",
   "names": []
  },
  {
   "v": 131,
   "text": "פִּֽי־פָ֭עַרְתִּי וָאֶשְׁאָ֑פָה כִּ֖י לְמִצְוֺתֶ֣יךָ יָאָֽבְתִּי׃",
   "names": []
  },
  {
   "v": 132,
   "text": "פְּנֵה־אֵלַ֥י וְחׇנֵּ֑נִי כְּ֝מִשְׁפָּ֗ט לְאֹהֲבֵ֥י שְׁמֶֽךָ׃",
   "names": []
  },
  {
   "v": 133,
   "text": "פְּ֭עָמַי הָכֵ֣ן בְּאִמְרָתֶ֑ךָ וְֽאַל־תַּשְׁלֶט־בִּ֥י כׇל־אָֽוֶן׃",
   "names": []
  },
  {
   "v": 134,
   "text": "פְּ֭דֵנִי מֵעֹ֣שֶׁק אָדָ֑ם וְ֝אֶשְׁמְרָ֗ה פִּקּוּדֶֽיךָ׃",
   "names": []
  },
  {
   "v": 135,
   "text": "פָּ֭נֶיךָ הָאֵ֣ר בְּעַבְדֶּ֑ךָ וְ֝לַמְּדֵ֗נִי אֶת־חֻקֶּֽיךָ׃",
   "names": []
  },
  {
   "v": 136,
   "text": "פַּלְגֵי־מַ֭יִם יָרְד֣וּ עֵינָ֑י עַ֝֗ל לֹא־שָׁמְר֥וּ תוֹרָתֶֽךָ׃",
   "names": []
  },
  {
   "v": 137,
   "text": "צַדִּ֣יק אַתָּ֣ה ה' וְ֝יָשָׁ֗ר מִשְׁפָּטֶֽיךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 17,
     "end": 19,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 138,
   "text": "צִ֭וִּיתָ צֶ֣דֶק עֵדֹתֶ֑יךָ וֶאֱמוּנָ֥ה מְאֹֽד׃",
   "names": []
  },
  {
   "v": 139,
   "text": "צִמְּתַ֥תְנִי קִנְאָתִ֑י כִּֽי־שָׁכְח֖וּ דְבָרֶ֣יךָ צָרָֽי׃",
   "names": []
  },
  {
   "v": 140,
   "text": "צְרוּפָ֖ה אִמְרָתְךָ֥ מְאֹ֗ד וְֽעַבְדְּךָ֥ אֲהֵבָֽהּ׃",
   "names": []
  },
  {
   "v": 141,
   "text": "צָעִ֣יר אָנֹכִ֣י וְנִבְזֶ֑ה פִּ֝קֻּדֶ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃",
   "names": []
  },
  {
   "v": 142,
   "text": "צִדְקָתְךָ֣ צֶ֣דֶק לְעוֹלָ֑ם וְֽתוֹרָתְךָ֥ אֱמֶֽת׃",
   "names": []
  },
  {
   "v": 143,
   "text": "צַר־וּמָצ֥וֹק מְצָא֑וּנִי מִ֝צְוֺתֶ֗יךָ שַׁעֲשֻׁעָֽי׃",
   "names": []
  },
  {
   "v": 144,
   "text": "צֶ֖דֶק עֵדְוֺתֶ֥יךָ לְעוֹלָ֗ם הֲבִינֵ֥נִי וְאֶחְיֶֽה׃",
   "names": []
  },
  {
   "v": 145,
   "text": "קָרָ֣אתִי בְכׇל־לֵ֭ב עֲנֵ֥נִי ה' חֻקֶּ֥יךָ אֶצֹּֽרָה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 30,
     "end": 32,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 146,
   "text": "קְרָאתִ֥יךָ הוֹשִׁיעֵ֑נִי וְ֝אֶשְׁמְרָ֗ה עֵדֹתֶֽיךָ׃",
   "names": []
  },
  {
   "v": 147,
   "text": "קִדַּ֣מְתִּי בַ֭נֶּשֶׁף וָאֲשַׁוֵּ֑עָה (לדבריך) [לִדְבָרְךָ֥] יִחָֽלְתִּי׃",
   "names": []
  },
  {
   "v": 148,
   "text": "קִדְּמ֣וּ עֵ֭ינַי אַשְׁמֻר֑וֹת לָ֝שִׂ֗יחַ בְּאִמְרָתֶֽךָ׃",
   "names": []
  },
  {
   "v": 149,
   "text": "ק֭וֹלִי שִׁמְעָ֣ה כְחַסְדֶּ֑ךָ ה' כְּֽמִשְׁפָּטֶ֥ךָ חַיֵּֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 31,
     "end": 33,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 150,
   "text": "קָ֭רְבוּ רֹדְפֵ֣י זִמָּ֑ה מִתּוֹרָתְךָ֥ רָחָֽקוּ׃",
   "names": []
  },
  {
   "v": 151,
   "text": "קָר֣וֹב אַתָּ֣ה ה' וְֽכׇל־מִצְוֺתֶ֥יךָ אֱמֶֽת׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 16,
     "end": 18,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 152,
   "text": "קֶ֣דֶם יָ֭דַעְתִּי מֵעֵדֹתֶ֑יךָ כִּ֖י לְעוֹלָ֣ם יְסַדְתָּֽם׃",
   "names": []
  },
  {
   "v": 153,
   "text": "רְאֵה־עׇנְיִ֥י וְחַלְּצֵ֑נִי כִּי־ת֥֝וֹרָתְךָ֗ לֹ֣א שָׁכָֽחְתִּי׃",
   "names": []
  },
  {
   "v": 154,
   "text": "רִיבָ֣ה רִ֭יבִי וּגְאָלֵ֑נִי לְאִמְרָתְךָ֥ חַיֵּֽנִי׃",
   "names": []
  },
  {
   "v": 155,
   "text": "רָח֣וֹק מֵרְשָׁעִ֣ים יְשׁוּעָ֑ה כִּי־חֻ֝קֶּ֗יךָ לֹ֣א דָרָֽשׁוּ׃",
   "names": []
  },
  {
   "v": 156,
   "text": "רַחֲמֶ֖יךָ רַבִּ֥ים ׀ ה' כְּֽמִשְׁפָּטֶ֥יךָ חַיֵּֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 22,
     "end": 24,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 157,
   "text": "רַ֭בִּים רֹדְפַ֣י וְצָרָ֑י מֵ֝עֵדְוֺתֶ֗יךָ לֹ֣א נָטִֽיתִי׃",
   "names": []
  },
  {
   "v": 158,
   "text": "רָאִ֣יתִי בֹ֭גְדִים וָאֶתְקוֹטָ֑טָה אֲשֶׁ֥ר אִ֝מְרָתְךָ֗ לֹ֣א שָׁמָֽרוּ׃",
   "names": []
  },
  {
   "v": 159,
   "text": "רְ֭אֵה כִּי־פִקּוּדֶ֣יךָ אָהָ֑בְתִּי ה' כְּֽחַסְדְּךָ֥ חַיֵּֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 37,
     "end": 39,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 160,
   "text": "רֹאשׁ־דְּבָרְךָ֥ אֱמֶ֑ת וּ֝לְעוֹלָ֗ם כׇּל־מִשְׁפַּ֥ט צִדְקֶֽךָ׃",
   "names": []
  },
  {
   "v": 161,
   "text": "שָׂ֭רִים רְדָפ֣וּנִי חִנָּ֑ם (ומדבריך) [וּ֝מִדְּבָרְךָ֗] פָּחַ֥ד לִבִּֽי׃",
   "names": []
  },
  {
   "v": 162,
   "text": "שָׂ֣שׂ אָ֭נֹכִי עַל־אִמְרָתֶ֑ךָ כְּ֝מוֹצֵ֗א שָׁלָ֥ל רָֽב׃",
   "names": []
  },
  {
   "v": 163,
   "text": "שֶׁ֣קֶר שָׂ֭נֵאתִי וַאֲתַעֵ֑בָה תּוֹרָתְךָ֥ אָהָֽבְתִּי׃",
   "names": []
  },
  {
   "v": 164,
   "text": "שֶׁ֣בַע בַּ֭יּוֹם הִלַּלְתִּ֑יךָ עַ֝֗ל מִשְׁפְּטֵ֥י צִדְקֶֽךָ׃",
   "names": []
  },
  {
   "v": 165,
   "text": "שָׁל֣וֹם רָ֭ב לְאֹהֲבֵ֣י תוֹרָתֶ֑ךָ וְאֵֽין־לָ֥מוֹ מִכְשֽׁוֹל׃",
   "names": []
  },
  {
   "v": 166,
   "text": "שִׂבַּ֣רְתִּי לִישׁוּעָתְךָ֣ ה' וּֽמִצְוֺתֶ֥יךָ עָשִֽׂיתִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 29,
     "end": 31,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 167,
   "text": "שָֽׁמְרָ֣ה נַ֭פְשִׁי עֵדֹתֶ֑יךָ וָאֹהֲבֵ֥ם מְאֹֽד׃",
   "names": []
  },
  {
   "v": 168,
   "text": "שָׁמַ֣רְתִּי פִ֭קּוּדֶיךָ וְעֵדֹתֶ֑יךָ כִּ֖י כׇל־דְּרָכַ֣י נֶגְדֶּֽךָ׃",
   "names": []
  },
  {
   "v": 169,
   "text": "תִּקְרַ֤ב רִנָּתִ֣י לְפָנֶ֣יךָ ה' כִּדְבָרְךָ֥ הֲבִינֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 31,
     "end": 33,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 170,
   "text": "תָּב֣וֹא תְחִנָּתִ֣י לְפָנֶ֑יךָ כְּ֝אִמְרָתְךָ֗ הַצִּילֵֽנִי׃",
   "names": []
  },
  {
   "v": 171,
   "text": "תַּבַּ֣עְנָה שְׂפָתַ֣י תְּהִלָּ֑ה כִּ֖י תְלַמְּדֵ֣נִי חֻקֶּֽיךָ׃",
   "names": []
  },
  {
   "v": 172,
   "text": "תַּ֣עַן לְ֭שׁוֹנִי אִמְרָתֶ֑ךָ כִּ֖י כׇל־מִצְוֺתֶ֣יךָ צֶּֽדֶק׃",
   "names": []
  },
  {
   "v": 173,
   "text": "תְּהִי־יָדְךָ֥ לְעׇזְרֵ֑נִי כִּ֖י פִקּוּדֶ֣יךָ בָחָֽרְתִּי׃",
   "names": []
  },
  {
   "v": 174,
   "text": "תָּאַ֣בְתִּי לִישׁוּעָתְךָ֣ ה' וְ֝ת֥וֹרָתְךָ֗ שַׁעֲשֻׁעָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 28,
     "end": 30,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 175,
   "text": "תְּֽחִי־נַ֭פְשִׁי וּֽתְהַלְלֶ֑ךָּ וּֽמִשְׁפָּטֶ֥ךָ יַעְזְרֻֽנִי׃",
   "names": []
  },
  {
   "v": 176,
   "text": "תָּעִ֗יתִי כְּשֶׂ֣ה אֹ֭בֵד בַּקֵּ֣שׁ עַבְדֶּ֑ךָ כִּ֥י מִ֝צְוֺתֶ֗יךָ לֹ֣א שָׁכָֽחְתִּי׃",
   "names": []
  }
