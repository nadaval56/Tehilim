     "start": 40,
     "end": 42,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "אֲהַלְלָ֣ה ה' בְּחַיָּ֑י אֲזַמְּרָ֖ה לֵא-לֹהַ֣י בְּעוֹדִֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 11,
     "end": 13,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
