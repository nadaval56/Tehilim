     "prefix": "ל",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "אַל־תִּבְטְח֥וּ בִנְדִיבִ֑ים בְּבֶן־אָדָ֓ם ׀ שֶׁ֤אֵ֖ין ל֥וֹ תְשׁוּעָֽה׃",
   "names": []
  },
  {
   "v": 4,
   "text": "תֵּצֵ֣א ר֭וּחוֹ יָשֻׁ֣ב לְאַדְמָת֑וֹ בַּיּ֥וֹם הַ֝ה֗וּא אָבְד֥וּ עֶשְׁתֹּנֹתָֽיו׃",
   "names": []
  },
  {
   "v": 5,
   "text": "אַשְׁרֵ֗י שֶׁ֤אֵ֣-ל יַעֲקֹ֣ב בְּעֶזְר֑וֹ שִׂ֝בְר֗וֹ עַל־ה' אֱ-לֹהָֽיו׃",
   "names": [
    {
     "type": "EL",
     "word": 1,
     "start": 10,
     "end": 19,
     "prefix": "ש",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 6,
     "start": 56,
     "end": 58,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
