     "word": 7,
     "start": 59,
     "end": 69,
     "prefix": "",
     "suffix": "יו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "עֹשֶׂ֤ה ׀ שָׁ֘מַ֤יִם וָאָ֗רֶץ אֶת־הַיָּ֥ם וְאֶת־כׇּל־אֲשֶׁר־בָּ֑ם הַשֹּׁמֵ֖ר אֱמֶ֣ת לְעוֹלָֽם׃",
   "names": []
  },
  {
   "v": 7,
   "text": "עֹשֶׂ֤ה מִשְׁפָּ֨ט ׀ לָעֲשׁוּקִ֗ים נֹתֵ֣ן לֶ֭חֶם לָרְעֵבִ֑ים ה' מַתִּ֥יר אֲסוּרִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 6,
     "start": 61,
     "end": 63,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "ה' ׀ פֹּ֘קֵ֤חַ עִוְרִ֗ים ה' זֹקֵ֣ף כְּפוּפִ֑ים ה' אֹהֵ֥ב צַדִּיקִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
