 "verses": [
  {
   "v": 1,
   "text": "הַֽלְלוּ־יָ֡הּ הַֽלְלִ֥י נַ֝פְשִׁ֗י אֶת־ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
