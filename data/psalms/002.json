 "verses": [
  {
   "v": 1,
   "text": "לָ֭מָּה רָגְשׁ֣וּ גוֹיִ֑ם וּ֝לְאֻמִּ֗ים יֶהְגּוּ־רִֽיק׃",
   "names": []
  },
  {
   "v": 2,
   "text": "יִ֥תְיַצְּב֨וּ ׀ מַלְכֵי־אֶ֗רֶץ וְרוֹזְנִ֥ים נֽוֹסְדוּ־יָ֑חַד עַל־ה' וְעַל־מְשִׁיחֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 66,
     "end": 68,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "נְֽ֭נַתְּקָה אֶת־מֽוֹסְרוֹתֵ֑ימוֹ וְנַשְׁלִ֖יכָה מִמֶּ֣נּוּ עֲבֹתֵֽימוֹ׃",
   "names": []
  },
  {
   "v": 4,
   "text": "יוֹשֵׁ֣ב בַּשָּׁמַ֣יִם יִשְׂחָ֑ק אֲ֝-דֹנָ֗י יִלְעַג־לָֽמוֹ׃",
   "names": [
    {
     "type": "ADNI",
     "word": 3,
     "start": 33,
     "end": 43,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "אָ֤ז יְדַבֵּ֣ר אֵלֵ֣ימוֹ בְאַפּ֑וֹ וּֽבַחֲרוֹנ֥וֹ יְבַהֲלֵֽמוֹ׃",
   "names": []
  },
  {
   "v": 6,
   "text": "וַ֭אֲנִי נָסַ֣כְתִּי מַלְכִּ֑י עַל־צִ֝יּ֗וֹן הַר־קׇדְשִֽׁי׃",
   "names": []
  },
  {
   "v": 7,
   "text": "אֲסַפְּרָ֗ה אֶֽ֫ל־חֹ֥ק ה' אָמַ֘ר־אֵלַ֥י בְּנִ֥י אַ֑תָּה אֲ֝נִ֗י הַיּ֥וֹם יְלִדְתִּֽיךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 23,
     "end": 25,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "שְׁאַ֤ל מִמֶּ֗נִּי וְאֶתְּנָ֣ה ג֭וֹיִם נַחֲלָתֶ֑ךָ וַ֝אֲחֻזָּתְךָ֗ אַפְסֵי־אָֽרֶץ׃",
   "names": []
  },
  {
   "v": 9,
   "text": "תְּ֭רֹעֵם בְּשֵׁ֣בֶט בַּרְזֶ֑ל כִּכְלִ֖י יוֹצֵ֣ר תְּנַפְּצֵֽם׃",
   "names": []
  },
  {
   "v": 10,
   "text": "וְ֭עַתָּה מְלָכִ֣ים הַשְׂכִּ֑ילוּ הִ֝וָּסְר֗וּ שֹׁ֣פְטֵי אָֽרֶץ׃",
   "names": []
  },
  {
   "v": 11,
   "text": "עִבְד֣וּ אֶת־ה' בְּיִרְאָ֑ה וְ֝גִ֗ילוּ בִּרְעָדָֽה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 13,
     "end": 15,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "נַשְּׁקוּ־בַ֡ר פֶּן־יֶאֱנַ֤ף ׀ וְתֹ֬אבְדוּ דֶ֗רֶךְ כִּֽי־יִבְעַ֣ר כִּמְעַ֣ט אַפּ֑וֹ אַ֝שְׁרֵ֗י כׇּל־ח֥וֹסֵי בֽוֹ׃",
   "names": []
  }
 ],
