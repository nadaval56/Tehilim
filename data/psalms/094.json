 "verse_count": 23,
 "verses": [
  {
   "v": 1,
   "text": "אֵ-ל־נְקָמ֥וֹת ה' אֵ֖-ל נְקָמ֣וֹת הוֹפִֽיעַ׃",
   "names": [
    {
     "type": "EL",
     "word": 0,
     "start": 0,
     "end": 4,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 15,
     "end": 17,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 3,
     "start": 18,
     "end": 23,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "הִ֭נָּשֵׂא שֹׁפֵ֣ט הָאָ֑רֶץ הָשֵׁ֥ב גְּ֝מ֗וּל עַל־גֵּאִֽים׃",
   "names": []
  },
  {
   "v": 3,
   "text": "עַד־מָתַ֖י רְשָׁעִ֥ים ׀ ה' עַד־מָ֝תַ֗י רְשָׁעִ֥ים יַעֲלֹֽזוּ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 24,
     "end": 26,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "יַבִּ֣יעוּ יְדַבְּר֣וּ עָתָ֑ק יִ֝תְאַמְּר֗וּ כׇּל־פֹּ֥עֲלֵי אָֽוֶן׃",
   "names": []
  },
  {
   "v": 5,
   "text": "עַמְּךָ֣ ה' יְדַכְּא֑וּ וְֽנַחֲלָתְךָ֥ יְעַנּֽוּ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 9,
     "end": 11,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "אַלְמָנָ֣ה וְגֵ֣ר יַהֲרֹ֑גוּ וִ֖יתוֹמִ֣ים יְרַצֵּֽחוּ׃",
   "names": []
  },
  {
   "v": 7,
   "text": "וַ֭יֹּ֣אמְרוּ לֹ֣א יִרְאֶה־יָּ֑-הּ וְלֹא־יָ֝בִ֗ין אֱ-לֹהֵ֥י יַעֲקֹֽב׃",
   "names": [
    {
     "type": "YAH",
     "word": 3,
     "start": 27,
     "end": 34,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 50,
     "end": 59,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "בִּ֭ינוּ בֹּעֲרִ֣ים בָּעָ֑ם וּ֝כְסִילִ֗ים מָתַ֥י תַּשְׂכִּֽילוּ׃",
   "names": []
  },
  {
   "v": 9,
   "text": "הֲנֹ֣טַֽע אֹ֭זֶן הֲלֹ֣א יִשְׁמָ֑ע אִֽם־יֹ֥צֵֽר עַ֝֗יִן הֲלֹ֣א יַבִּֽיט׃",
   "names": []
  },
  {
   "v": 10,
   "text": "הֲיֹסֵ֣ר גּ֭וֹיִם הֲלֹ֣א יוֹכִ֑יחַ הַֽמְלַמֵּ֖ד אָדָ֣ם דָּֽעַת׃",
   "names": []
  },
  {
   "v": 11,
   "text": "ה' יֹ֭דֵעַ מַחְשְׁב֣וֹת אָדָ֑ם כִּי־הֵ֥מָּה הָֽבֶל׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "אַשְׁרֵ֤י ׀ הַגֶּ֣בֶר אֲשֶׁר־תְּיַסְּרֶ֣נּוּ יָּ֑-הּ וּֽמִתּוֹרָתְךָ֥ תְלַמְּדֶֽנּוּ׃",
   "names": [
    {
     "type": "YAH",
     "word": 4,
     "start": 45,
     "end": 52,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "לְהַשְׁקִ֣יט ל֭וֹ מִ֣ימֵי רָ֑ע עַ֤ד יִכָּרֶ֖ה לָרָשָׁ֣ע שָֽׁחַת׃",
   "names": []
  },
  {
   "v": 14,
   "text": "כִּ֤י ׀ לֹא־יִטֹּ֣שׁ ה' עַמּ֑וֹ וְ֝נַחֲלָת֗וֹ לֹ֣א יַעֲזֹֽב׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 21,
     "end": 23,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "כִּֽי־עַד־צֶ֭דֶק יָשׁ֣וּב מִשְׁפָּ֑ט וְ֝אַחֲרָ֗יו כׇּל־יִשְׁרֵי־לֵֽב׃",
   "names": []
  },
  {
   "v": 16,
   "text": "מִֽי־יָק֣וּם לִ֭י עִם־מְרֵעִ֑ים מִי־יִתְיַצֵּ֥ב לִ֝֗י עִם־פֹּ֥עֲלֵי אָֽוֶן׃",
   "names": []
  },
  {
   "v": 17,
   "text": "לוּלֵ֣י ה' עֶזְרָ֣תָה לִּ֑י כִּמְעַ֓ט ׀ שָׁכְנָ֖ה דוּמָ֣ה נַפְשִֽׁי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 8,
     "end": 10,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 18,
   "text": "אִם־אָ֭מַרְתִּי מָ֣טָה רַגְלִ֑י חַסְדְּךָ֥ ה' יִסְעָדֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 43,
     "end": 45,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 19,
   "text": "בְּרֹ֣ב שַׂרְעַפַּ֣י בְּקִרְבִּ֑י תַּ֝נְחוּמֶ֗יךָ יְֽשַׁעַשְׁע֥וּ נַפְשִֽׁי׃",
   "names": []
  },
  {
   "v": 20,
   "text": "הַֽ֭יְחׇבְרְךָ כִּסֵּ֣א הַוּ֑וֹת יֹצֵ֖ר עָמָ֣ל עֲלֵי־חֹֽק׃",
   "names": []
  },
  {
   "v": 21,
   "text": "יָ֭גוֹדּוּ עַל־נֶ֣פֶשׁ צַדִּ֑יק וְדָ֖ם נָקִ֣י יַרְשִֽׁיעוּ׃",
   "names": []
  },
  {
   "v": 22,
   "text": "וַיְהִ֬י ה' לִ֣י לְמִשְׂגָּ֑ב וֵ֝א-לֹהַ֗י לְצ֣וּר מַחְסִֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 9,
     "end": 11,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 30,
     "end": 41,
     "prefix": "ו",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 23,
   "text": "וַיָּ֤שֶׁב עֲלֵיהֶ֨ם ׀ אֶת־אוֹנָ֗ם וּבְרָעָתָ֥ם יַצְמִיתֵ֑ם יַ֝צְמִיתֵ֗ם ה' אֱ-לֹהֵֽינוּ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 73,
     "end": 75,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 8,
     "start": 76,
     "end": 88,
     "prefix": "",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
 ],
