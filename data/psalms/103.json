 "verse_count": 22,
 "verses": [
  {
   "v": 1,
   "text": "לְדָוִ֨ד ׀ בָּרְכִ֣י נַ֭פְשִׁי אֶת־ה' וְכׇל־קְ֝רָבַ֗י אֶת־שֵׁ֥ם קׇדְשֽׁוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 35,
     "end": 37,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "בָּרְכִ֣י נַ֭פְשִׁי אֶת־ה' וְאַל־תִּ֝שְׁכְּחִ֗י כׇּל־גְּמוּלָֽיו׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 24,
     "end": 26,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "הַסֹּלֵ֥חַ לְכׇל־עֲוֺנֵ֑כִי הָ֝רֹפֵ֗א לְכׇל־תַּחֲלוּאָֽיְכִי׃",
   "names": []
  },
  {
   "v": 4,
   "text": "הַגּוֹאֵ֣ל מִשַּׁ֣חַת חַיָּ֑יְכִי הַֽ֝מְעַטְּרֵ֗כִי חֶ֣סֶד וְרַחֲמִֽים׃",
   "names": []
  },
  {
   "v": 5,
   "text": "הַמַּשְׂבִּ֣יעַ בַּטּ֣וֹב עֶדְיֵ֑ךְ תִּתְחַדֵּ֖שׁ כַּנֶּ֣שֶׁר נְעוּרָֽיְכִי׃",
   "names": []
  },
  {
   "v": 6,
   "text": "עֹשֵׂ֣ה צְדָק֣וֹת ה' וּ֝מִשְׁפָּטִ֗ים לְכׇל־עֲשׁוּקִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 18,
     "end": 20,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "יוֹדִ֣יעַ דְּרָכָ֣יו לְמֹשֶׁ֑ה לִבְנֵ֥י יִ֝שְׂרָאֵ֗ל עֲלִילוֹתָֽיו׃",
   "names": []
  },
  {
   "v": 8,
   "text": "רַח֣וּם וְחַנּ֣וּן ה' אֶ֖רֶךְ אַפַּ֣יִם וְרַב־חָֽסֶד׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 19,
     "end": 21,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "לֹא־לָנֶ֥צַח יָרִ֑יב וְלֹ֖א לְעוֹלָ֣ם יִטּֽוֹר׃",
   "names": []
  },
  {
   "v": 10,
   "text": "לֹ֣א כַ֭חֲטָאֵינוּ עָ֣שָׂה לָ֑נוּ וְלֹ֥א כַ֝עֲוֺנֹתֵ֗ינוּ גָּמַ֥ל עָלֵֽינוּ׃",
   "names": []
  },
  {
   "v": 11,
   "text": "כִּ֤י כִגְבֹ֣הַּ שָׁ֭מַיִם עַל־הָאָ֑רֶץ גָּבַ֥ר חַ֝סְדּ֗וֹ עַל־יְרֵאָֽיו׃",
   "names": []
  },
  {
   "v": 12,
   "text": "כִּרְחֹ֣ק מִ֭זְרָח מִֽמַּעֲרָ֑ב הִֽרְחִ֥יק מִ֝מֶּ֗נּוּ אֶת־פְּשָׁעֵֽינוּ׃",
   "names": []
  },
  {
   "v": 13,
   "text": "כְּרַחֵ֣ם אָ֭ב עַל־בָּנִ֑ים רִחַ֥ם ה' עַל־יְרֵאָֽיו׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 35,
     "end": 37,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 14,
   "text": "כִּי־ה֭וּא יָדַ֣ע יִצְרֵ֑נוּ זָ֝כ֗וּר כִּי־עָפָ֥ר אֲנָֽחְנוּ׃",
   "names": []
  },
  {
   "v": 15,
   "text": "אֱ֭נוֹשׁ כֶּחָצִ֣יר יָמָ֑יו כְּצִ֥יץ הַ֝שָּׂדֶ֗ה כֵּ֣ן יָצִֽיץ׃",
   "names": []
  },
  {
   "v": 16,
   "text": "כִּ֤י ר֣וּחַ עָֽבְרָה־בּ֣וֹ וְאֵינֶ֑נּוּ וְלֹֽא־יַכִּירֶ֖נּוּ ע֣וֹד מְקוֹמֽוֹ׃",
   "names": []
  },
  {
   "v": 17,
   "text": "וְחֶ֤סֶד ה' ׀ מֵעוֹלָ֣ם וְעַד־ע֭וֹלָם עַל־יְרֵאָ֑יו וְ֝צִדְקָת֗וֹ לִבְנֵ֥י בָנִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 9,
     "end": 11,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 18,
   "text": "לְשֹׁמְרֵ֥י בְרִית֑וֹ וּלְזֹכְרֵ֥י פִ֝קֻּדָ֗יו לַעֲשׂוֹתָֽם׃",
   "names": []
  },
  {
   "v": 19,
   "text": "ה' בַּ֭שָּׁמַיִם הֵכִ֣ין כִּסְא֑וֹ וּ֝מַלְכוּת֗וֹ בַּכֹּ֥ל מָשָֽׁלָה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 20,
   "text": "בָּרְכ֥וּ ה' מַלְאָ֫כָ֥יו גִּבֹּ֣רֵי כֹ֭חַ עֹשֵׂ֣י דְבָר֑וֹ לִ֝שְׁמֹ֗עַ בְּק֣וֹל דְּבָרֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 21,
   "text": "בָּרְכ֣וּ ה' כׇּל־צְבָאָ֑יו מְ֝שָׁרְתָ֗יו עֹשֵׂ֥י רְצוֹנֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 22,
   "text": "בָּרְכ֤וּ ה' ׀ כׇּֽל־מַעֲשָׂ֗יו בְּכׇל־מְקֹמ֥וֹת מֶמְשַׁלְתּ֑וֹ בָּרְכִ֥י נַ֝פְשִׁ֗י אֶת־ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
