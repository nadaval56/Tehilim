 "verse_count": 17,
 "verses": [
  {
   "v": 1,
   "text": "תְּפִלָּ֗ה לְדָ֫וִ֥ד הַטֵּֽה־ה' אׇזְנְךָ֣ עֲנֵ֑נִי כִּֽי־עָנִ֖י וְאֶבְי֣וֹן אָֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 29,
     "end": 31,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "שׇׁ֥מְרָ֣ה נַפְשִׁי֮ כִּֽי־חָסִ֢יד אָ֥֫נִי הוֹשַׁ֣ע עַ֭בְדְּךָ אַתָּ֣ה אֱ-לֹהַ֑י הַבּוֹטֵ֥חַ אֵלֶֽיךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 8,
     "start": 71,
     "end": 80,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "חׇנֵּ֥נִי אֲ-דֹנָ֑י כִּ֥י אֵלֶ֥יךָ אֶ֝קְרָ֗א כׇּל־הַיּֽוֹם׃",
   "names": [
    {
     "type": "ADNI",
     "word": 1,
     "start": 10,
     "end": 19,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "שַׂ֭מֵּחַ נֶ֣פֶשׁ עַבְדֶּ֑ךָ כִּ֥י אֵלֶ֥יךָ אֲ֝-דֹנָ֗י נַפְשִׁ֥י אֶשָּֽׂא׃",
   "names": [
    {
     "type": "ADNI",
     "word": 5,
     "start": 44,
     "end": 54,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "כִּֽי־אַתָּ֣ה אֲ֭-דֹנָי ט֣וֹב וְסַלָּ֑ח וְרַב־חֶ֝֗סֶד לְכׇל־קֹֽרְאֶֽיךָ׃",
   "names": [
    {
     "type": "ADNI",
     "word": 2,
     "start": 14,
     "end": 23,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "הַאֲזִ֣ינָה ה' תְּפִלָּתִ֑י וְ֝הַקְשִׁ֗יבָה בְּק֣וֹל תַּחֲנוּנוֹתָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 12,
     "end": 14,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "בְּי֣וֹם צָ֭רָתִֽי אֶקְרָאֶ֗ךָּ כִּ֣י תַעֲנֵֽנִי׃",
   "names": []
  },
  {
   "v": 8,
   "text": "אֵין־כָּמ֖וֹךָ בָאֱ-לֹהִ֥ים ׀ אֲ-דֹנָ֗י וְאֵ֣ין כְּֽמַעֲשֶֽׂיךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 15,
     "end": 27,
     "prefix": "ב",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ADNI",
     "word": 3,
     "start": 30,
     "end": 39,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "כׇּל־גּוֹיִ֤ם ׀ אֲשֶׁ֥ר עָשִׂ֗יתָ יָב֤וֹאוּ ׀ וְיִשְׁתַּחֲו֣וּ לְפָנֶ֣יךָ אֲ-דֹנָ֑י וִ֖יכַבְּד֣וּ לִשְׁמֶֽךָ׃",
   "names": [
    {
     "type": "ADNI",
     "word": 7,
     "start": 74,
     "end": 83,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "כִּֽי־גָד֣וֹל אַ֭תָּה וְעֹשֵׂ֣ה נִפְלָא֑וֹת אַתָּ֖ה אֱ-לֹהִ֣ים לְבַדֶּֽךָ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 52,
     "end": 62,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "ה֘וֹרֵ֤נִי ה' ׀ דַּרְכֶּ֗ךָ אֲהַלֵּ֥ךְ בַּאֲמִתֶּ֑ךָ יַחֵ֥ד לְ֝בָבִ֗י לְיִרְאָ֥ה שְׁמֶֽךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 11,
     "end": 13,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "אוֹדְךָ֤ ׀ אֲ-דֹנָ֣י אֱ֭-לֹהַי בְּכׇל־לְבָבִ֑י וַאֲכַבְּדָ֖ה שִׁמְךָ֣ לְעוֹלָֽם׃",
   "names": [
    {
     "type": "ADNI",
     "word": 1,
     "start": 11,
     "end": 20,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 21,
     "end": 30,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "כִּֽי־חַ֭סְדְּךָ גָּד֣וֹל עָלָ֑י וְהִצַּ֥לְתָּ נַ֝פְשִׁ֗י מִשְּׁא֥וֹל תַּחְתִּיָּֽה׃",
   "names": []
  },
  {
   "v": 14,
   "text": "אֱ-לֹהִ֤ים ׀ זֵ֘דִ֤ים קָמוּ־עָלַ֗י וַעֲדַ֣ת עָ֭רִיצִים בִּקְשׁ֣וּ נַפְשִׁ֑י וְלֹ֖א שָׂמ֣וּךָ לְנֶגְדָּֽם׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 10,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "וְאַתָּ֣ה אֲ֭-דֹנָי אֵ-ל־רַח֣וּם וְחַנּ֑וּן אֶ֥רֶךְ אַ֝פַּ֗יִם וְרַב־חֶ֥סֶד וֶאֱמֶֽת׃",
   "names": [
    {
     "type": "ADNI",
     "word": 1,
     "start": 10,
     "end": 19,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 2,
     "start": 20,
     "end": 24,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 16,
   "text": "פְּנֵ֥ה אֵלַ֗י וְחׇ֫נֵּ֥נִי תְּנָֽה־עֻזְּךָ֥ לְעַבְדֶּ֑ךָ וְ֝הוֹשִׁ֗יעָה לְבֶן־אֲמָתֶֽךָ׃",
   "names": []
  },
  {
   "v": 17,
   "text": "עֲשֵֽׂה־עִמִּ֥י א֗וֹת לְט֫וֹבָ֥ה וְיִרְא֣וּ שֹׂנְאַ֣י וְיֵבֹ֑שׁוּ כִּֽי־אַתָּ֥ה ה' עֲזַרְתַּ֥נִי וְנִחַמְתָּֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 9,
     "start": 80,
     "end": 82,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  }
