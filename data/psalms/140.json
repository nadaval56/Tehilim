 "verses": [
  {
   "v": 1,
   "text": "לַמְנַצֵּ֗חַ מִזְמ֥וֹר לְדָוִֽד׃",
   "names": []
  },
  {
   "v": 2,
   "text": "חַלְּצֵ֣נִי ה' מֵאָדָ֣ם רָ֑ע מֵאִ֖ישׁ חֲמָסִ֣ים תִּנְצְרֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 12,
     "end": 14,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "אֲשֶׁ֤ר חָשְׁב֣וּ רָע֣וֹת בְּלֵ֑ב כׇּל־י֝֗וֹם יָג֥וּרוּ מִלְחָמֽוֹת׃",
   "names": []
  },
  {
   "v": 4,
   "text": "שָׁ֥נְנ֣וּ לְשׁוֹנָם֮ כְּֽמוֹ־נָ֫חָ֥שׁ חֲמַ֥ת עַכְשׁ֑וּב תַּ֖חַת שְׂפָתֵ֣ימוֹ סֶֽלָה׃",
   "names": []
  },
  {
   "v": 5,
   "text": "שׇׁמְרֵ֤נִי ה' ׀ מִ֘ידֵ֤י רָשָׁ֗ע מֵאִ֣ישׁ חֲמָסִ֣ים תִּנְצְרֵ֑נִי אֲשֶׁ֥ר חָ֝שְׁב֗וּ לִדְח֥וֹת פְּעָמָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 12,
     "end": 14,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "טָ֥מְנֽוּ־גֵאִ֨ים ׀ פַּ֡ח לִ֗י וַחֲבָלִ֗ים פָּ֣רְשׂוּ רֶ֭שֶׁת לְיַד־מַעְגָּ֑ל מֹקְשִׁ֖ים שָׁתוּ־לִ֣י סֶֽלָה׃",
   "names": []
  },
  {
   "v": 7,
   "text": "אָמַ֣רְתִּי לַ֭ה' אֵ֣-לִי אָ֑תָּה הַאֲזִ֥ינָה ה' ק֣וֹל תַּחֲנוּנָֽי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 12,
     "end": 17,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 2,
     "start": 18,
     "end": 25,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 46,
     "end": 48,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "ה' אֲ֭-דֹנָי עֹ֣ז יְשׁוּעָתִ֑י סַכֹּ֥תָה לְ֝רֹאשִׁ֗י בְּי֣וֹם נָֽשֶׁק׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ADNI",
     "word": 1,
     "start": 3,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "אַל־תִּתֵּ֣ן ה' מַאֲוַיֵּ֣י רָשָׁ֑ע זְמָמ֥וֹ אַל־תָּ֝פֵ֗ק יָר֥וּמוּ סֶֽלָה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 13,
     "end": 15,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "רֹ֥אשׁ מְסִבָּ֑י עֲמַ֖ל שְׂפָתֵ֣ימוֹ (יכסומו) [יְכַסֵּֽימוֹ]׃",
   "names": []
  },
  {
   "v": 11,
   "text": "(ימיטו) [יִמּ֥וֹטוּ] עֲלֵיהֶ֗ם גֶּחָ֫לִ֥ים בָּאֵ֥שׁ יַפִּלֵ֑ם בְּ֝מַהֲמֹר֗וֹת בַּל־יָקֽוּמוּ׃",
   "names": []
  },
  {
   "v": 12,
   "text": "אִ֥ישׁ לָשׁוֹן֮ בַּל־יִכּ֢וֹן בָּ֫אָ֥רֶץ אִישׁ־חָמָ֥ס רָ֑ע יְ֝צוּדֶ֗נּוּ לְמַדְחֵפֹֽת׃",
   "names": []
  },
  {
   "v": 13,
   "text": "(ידעת) [יָדַ֗עְתִּי] כִּֽי־יַעֲשֶׂ֣ה ה' דִּ֣ין עָנִ֑י מִ֝שְׁפַּ֗ט אֶבְיֹנִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 37,
     "end": 39,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 14,
   "text": "אַ֣ךְ צַ֭דִּיקִים יוֹד֣וּ לִשְׁמֶ֑ךָ יֵשְׁב֥וּ יְ֝שָׁרִ֗ים אֶת־פָּנֶֽיךָ׃",
   "names": []
  }
 ],
