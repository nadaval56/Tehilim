{
 "n": 147,
 "book": 5,
 "heading": null,
 "verse_count": 20,
 "verses": [
  {
   "v": 1,
   "text": "הַ֥לְלוּ־יָ֨הּ ׀ כִּי־ט֭וֹב זַמְּרָ֣ה אֱ-לֹהֵ֑ינוּ כִּי־נָ֝עִ֗ים נָאוָ֥ה תְהִלָּֽה׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 38,
     "end": 50,
     "prefix": "",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "בּוֹנֵ֣ה יְרוּשָׁלַ֣͏ִם ה' נִדְחֵ֖י יִשְׂרָאֵ֣ל יְכַנֵּֽס׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 24,
     "end": 26,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "הָ֭רֹפֵא לִשְׁב֣וּרֵי לֵ֑ב וּ֝מְחַבֵּ֗שׁ לְעַצְּבוֹתָֽם׃",
   "names": []
  },
  {
   "v": 4,
   "text": "מוֹנֶ֣ה מִ֭סְפָּר לַכּוֹכָבִ֑ים לְ֝כֻלָּ֗ם שֵׁמ֥וֹת יִקְרָֽא׃",
   "names": []
  },
  {
   "v": 5,
   "text": "גָּד֣וֹל אֲ-דוֹנֵ֣ינוּ וְרַב־כֹּ֑חַ לִ֝תְבוּנָת֗וֹ אֵ֣ין מִסְפָּֽר׃",
   "names": [
    {
     "type": "ADNI",
     "word": 1,
     "start": 9,
     "end": 22,
     "prefix": "",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "מְעוֹדֵ֣ד עֲנָוִ֣ים ה' מַשְׁפִּ֖יל רְשָׁעִ֣ים עֲדֵי־אָֽרֶץ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 20,
     "end": 22,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "עֱנ֣וּ לַֽה' בְּתוֹדָ֑ה זַמְּר֖וּ לֵא-לֹהֵ֣ינוּ בְכִנּֽוֹר׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 7,
     "end": 12,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 4,
     "start": 34,
     "end": 47,
     "prefix": "ל",
     "suffix": "ינו",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "הַֽמְכַסֶּ֬ה שָׁמַ֨יִם ׀ בְּעָבִ֗ים הַמֵּכִ֣ין לָאָ֣רֶץ מָטָ֑ר הַמַּצְמִ֖יחַ הָרִ֣ים חָצִֽיר׃",
   "names": []
  },
  {
   "v": 9,
   "text": "נוֹתֵ֣ן לִבְהֵמָ֣ה לַחְמָ֑הּ לִבְנֵ֥י עֹ֝רֵ֗ב אֲשֶׁ֣ר יִקְרָֽאוּ׃",
   "names": []
  },
  {
   "v": 10,
   "text": "לֹ֤א בִגְבוּרַ֣ת הַסּ֣וּס יֶחְפָּ֑ץ לֹא־בְשׁוֹקֵ֖י הָאִ֣ישׁ יִרְצֶֽה׃",
   "names": []
  },
  {
   "v": 11,
   "text": "רוֹצֶ֣ה ה' אֶת־יְרֵאָ֑יו אֶת־הַֽמְיַחֲלִ֥ים לְחַסְדּֽוֹ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 8,
     "end": 10,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 12,
   "text": "שַׁבְּחִ֣י יְ֭רוּשָׁלַ͏ִם אֶת־ה' הַֽלְלִ֖י אֱ-לֹהַ֣יִךְ צִיּֽוֹן׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 30,
     "end": 32,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 43,
     "end": 55,
     "prefix": "",
     "suffix": "יך",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "כִּֽי־חִ֭זַּק בְּרִיחֵ֣י שְׁעָרָ֑יִךְ בֵּרַ֖ךְ בָּנַ֣יִךְ בְּקִרְבֵּֽךְ׃",
   "names": []
  },
  {
   "v": 14,
   "text": "הַשָּׂם־גְּבוּלֵ֥ךְ שָׁל֑וֹם חֵ֥לֶב חִ֝טִּ֗ים יַשְׂבִּיעֵֽךְ׃",
   "names": []
  },
  {
   "v": 15,
   "text": "הַשֹּׁלֵ֣חַ אִמְרָת֣וֹ אָ֑רֶץ עַד־מְ֝הֵרָ֗ה יָר֥וּץ דְּבָרֽוֹ׃",
   "names": []
  },
  {
   "v": 16,
   "text": "הַנֹּתֵ֣ן שֶׁ֣לֶג כַּצָּ֑מֶר כְּ֝פ֗וֹר כָּאֵ֥פֶר יְפַזֵּֽר׃",
   "names": []
  },
  {
   "v": 17,
   "text": "מַשְׁלִ֣יךְ קַֽרְח֣וֹ כְפִתִּ֑ים לִפְנֵ֥י קָ֝רָת֗וֹ מִ֣י יַעֲמֹֽד׃",
   "names": []
  },
  {
   "v": 18,
   "text": "יִשְׁלַ֣ח דְּבָר֣וֹ וְיַמְסֵ֑ם יַשֵּׁ֥ב ר֝וּח֗וֹ יִזְּלוּ־מָֽיִם׃",
   "names": []
  },
  {
   "v": 19,
   "text": "מַגִּ֣יד דְּבָרָ֣ו לְיַעֲקֹ֑ב חֻקָּ֥יו וּ֝מִשְׁפָּטָ֗יו לְיִשְׂרָאֵֽל׃",
   "names": []
  },
  {
   "v": 20,
   "text": "לֹ֘א־עָ֤שָׂה כֵ֨ן ׀ לְכׇל־גּ֗וֹי וּמִשְׁפָּטִ֥ים בַּל־יְדָע֗וּם הַֽלְלוּ־יָֽהּ׃",
   "names": []
  }
 ],
