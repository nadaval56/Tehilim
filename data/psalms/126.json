 "verses": [
  {
   "v": 1,
   "text": "שִׁ֗יר הַֽמַּ֫עֲל֥וֹת בְּשׁ֣וּב ה' אֶת־שִׁיבַ֣ת צִיּ֑וֹן הָ֝יִ֗ינוּ כְּחֹלְמִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 32,
     "end": 34,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "אָ֤ז יִמָּלֵ֪א שְׂח֡וֹק פִּינוּ֮ וּלְשׁוֹנֵ֢נוּ רִ֫נָּ֥ה אָ֭ז יֹאמְר֣וּ בַגּוֹיִ֑ם הִגְדִּ֥יל ה' לַעֲשׂ֥וֹת עִם־אֵֽלֶּה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 10,
     "start": 94,
     "end": 96,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "הִגְדִּ֣יל ה' לַעֲשׂ֥וֹת עִמָּ֗נוּ הָיִ֥ינוּ שְׂמֵחִֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 11,
     "end": 13,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "שׁוּבָ֣ה ה' אֶת־[שְׁבִיתֵ֑נוּ] (שבותנו) כַּאֲפִיקִ֥ים בַּנֶּֽגֶב׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 9,
     "end": 11,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "הַזֹּרְעִ֥ים בְּדִמְעָ֗ה בְּרִנָּ֥ה יִקְצֹֽרוּ׃",
   "names": []
  },
  {
   "v": 6,
   "text": "הָ֘ל֤וֹךְ יֵלֵ֨ךְ ׀ וּבָכֹה֮ נֹשֵׂ֢א מֶשֶׁךְ־הַ֫זָּ֥רַע בֹּא־יָבֹ֥א בְרִנָּ֑ה נֹ֝שֵׂ֗א אֲלֻמֹּתָֽיו׃",
   "names": []
  }
 ],
