 "verse_count": 21,
 "verses": [
  {
   "v": 1,
   "text": "לַמְנַצֵּ֥חַ עַֽל־[יְדוּת֗וּן] (ידיתון) לְאָסָ֥ף מִזְמֽוֹר׃",
   "names": []
  },
  {
   "v": 2,
   "text": "קוֹלִ֣י אֶל־אֱ-לֹהִ֣ים וְאֶצְעָ֑קָה קוֹלִ֥י אֶל־אֱ֝-לֹהִ֗ים וְהַאֲזִ֥ין אֵלָֽי׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 12,
     "end": 22,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 48,
     "end": 59,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "בְּי֥וֹם צָרָתִי֮ אֲ-דֹנָ֢י דָּ֫רָ֥שְׁתִּי יָדִ֤י ׀ לַ֣יְלָה נִ֭גְּרָה וְלֹ֣א תָפ֑וּג מֵאֲנָ֖ה הִנָּחֵ֣ם נַפְשִֽׁי׃",
   "names": [
    {
     "type": "ADNI",
     "word": 2,
     "start": 18,
     "end": 27,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "אֶזְכְּרָ֣ה אֱ-לֹהִ֣ים וְאֶהֱמָ֑יָה אָשִׂ֓יחָה ׀ וְתִתְעַטֵּ֖ף רוּחִ֣י סֶֽלָה׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 12,
     "end": 22,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "אָ֭חַזְתָּ שְׁמֻר֣וֹת עֵינָ֑י נִ֝פְעַ֗מְתִּי וְלֹ֣א אֲדַבֵּֽר׃",
   "names": []
  },
  {
   "v": 6,
   "text": "חִשַּׁ֣בְתִּי יָמִ֣ים מִקֶּ֑דֶם שְׁ֝נ֗וֹת עוֹלָמִֽים׃",
   "names": []
  },
  {
   "v": 7,
   "text": "אֶ֥זְכְּרָ֥ה נְגִינָתִ֗י בַּ֫לָּ֥יְלָה עִם־לְבָבִ֥י אָשִׂ֑יחָה וַיְחַפֵּ֥שׂ רוּחִֽי׃",
   "names": []
  },
  {
   "v": 8,
   "text": "הַֽ֭לְעוֹלָמִים יִזְנַ֥ח ׀ אֲ-דֹנָ֑י וְלֹא־יֹסִ֖יף לִרְצ֣וֹת עֽוֹד׃",
   "names": [
    {
     "type": "ADNI",
     "word": 2,
     "start": 27,
     "end": 36,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "הֶאָפֵ֣ס לָנֶ֣צַח חַסְדּ֑וֹ גָּ֥מַר אֹ֝֗מֶר לְדֹ֣ר וָדֹֽר׃",
   "names": []
  },
  {
   "v": 10,
   "text": "הֲשָׁכַ֣ח חַנּ֣וֹת אֵ֑-ל אִם־קָפַ֥ץ בְּ֝אַ֗ף רַחֲמָ֥יו סֶֽלָה׃",
   "names": [
    {
     "type": "EL",
     "word": 2,
     "start": 19,
     "end": 24,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "וָ֭אֹמַר חַלּ֣וֹתִי הִ֑יא שְׁ֝נ֗וֹת יְמִ֣ין עֶלְיֽוֹן׃",
   "names": []
  },
  {
   "v": 12,
   "text": "(אזכיר) [אֶזְכּ֥וֹר] מַעַלְלֵי־יָ֑-הּ כִּֽי־אֶזְכְּרָ֖ה מִקֶּ֣דֶם פִּלְאֶֽךָ׃",
   "names": [
    {
     "type": "YAH",
     "word": 3,
     "start": 31,
     "end": 37,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "וְהָגִ֥יתִי בְכׇל־פׇּעֳלֶ֑ךָ וּֽבַעֲלִ֖ילוֹתֶ֣יךָ אָשִֽׂיחָה׃",
   "names": []
  },
  {
   "v": 14,
   "text": "אֱ֭-לֹהִים בַּקֹּ֣דֶשׁ דַּרְכֶּ֑ךָ מִי־אֵ֥-ל גָּ֝ד֗וֹל כֵּא-לֹהִֽים׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 0,
     "start": 0,
     "end": 10,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 4,
     "start": 39,
     "end": 44,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 6,
     "start": 55,
     "end": 67,
     "prefix": "כ",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 15,
   "text": "אַתָּ֣ה הָ֭אֵ-ל עֹ֣שֵׂה פֶ֑לֶא הוֹדַ֖עְתָּ בָעַמִּ֣ים עֻזֶּֽךָ׃",
   "names": [
    {
     "type": "EL",
     "word": 1,
     "start": 8,
     "end": 15,
     "prefix": "ה",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 16,
   "text": "גָּאַ֣לְתָּ בִּזְר֣וֹעַ עַמֶּ֑ךָ בְּנֵֽי־יַעֲקֹ֖ב וְיוֹסֵ֣ף סֶֽלָה׃",
   "names": []
  },
  {
   "v": 17,
   "text": "רָ֘א֤וּךָ מַּ֨יִם ׀ אֱֽ-לֹהִ֗ים רָא֣וּךָ מַּ֣יִם יָחִ֑ילוּ אַ֝֗ף יִרְגְּז֥וּ תְהֹמֽוֹת׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 20,
     "end": 31,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 18,
   "text": "זֹ֤רְמוּ מַ֨יִם ׀ עָב֗וֹת ק֭וֹל נָתְנ֣וּ שְׁחָקִ֑ים אַף־חֲ֝צָצֶ֗יךָ יִתְהַלָּֽכוּ׃",
   "names": []
  },
  {
   "v": 19,
   "text": "ק֤וֹל רַעַמְךָ֨ ׀ בַּגַּלְגַּ֗ל הֵאִ֣ירוּ בְרָקִ֣ים תֵּבֵ֑ל רָגְזָ֖ה וַתִּרְעַ֣שׁ הָאָֽרֶץ׃",
   "names": []
  },
  {
   "v": 20,
   "text": "בַּיָּ֤ם דַּרְכֶּ֗ךָ (ושביליך) [וּֽ֭שְׁבִילְךָ] בְּמַ֣יִם רַבִּ֑ים וְ֝עִקְּבוֹתֶ֗יךָ לֹ֣א נֹדָֽעוּ׃",
   "names": []
  },
  {
   "v": 21,
   "text": "נָחִ֣יתָ כַצֹּ֣אן עַמֶּ֑ךָ בְּֽיַד־מֹשֶׁ֥ה וְאַהֲרֹֽן׃",
   "names": []
  }
 ],
