 "verses": [
  {
   "v": 1,
   "text": "מִזְמ֗וֹר לְדָ֫וִ֥ד הָב֣וּ לַ֭ה' בְּנֵ֣י אֵלִ֑ים הָב֥וּ לַ֝ה' כָּב֥וֹד וָעֹֽז׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 27,
     "end": 32,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 56,
     "end": 61,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "הָב֣וּ לַ֭ה' כְּב֣וֹד שְׁמ֑וֹ הִשְׁתַּחֲו֥וּ לַ֝ה' בְּהַדְרַת־קֹֽדֶשׁ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 7,
     "end": 12,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 45,
     "end": 50,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "ק֥וֹל ה' עַל־הַ֫מָּ֥יִם אֵֽ-ל־הַכָּב֥וֹד הִרְעִ֑ים ה' עַל־מַ֥יִם רַבִּֽים׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 6,
     "end": 8,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "EL",
     "word": 4,
     "start": 24,
     "end": 29,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 7,
     "start": 51,
     "end": 53,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 4,
   "text": "קוֹל־ה' בַּכֹּ֑חַ ק֥וֹל ה' בֶּהָדָֽר׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 5,
     "end": 7,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 24,
     "end": 26,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "ק֣וֹל ה' שֹׁבֵ֣ר אֲרָזִ֑ים וַיְשַׁבֵּ֥ר ה' אֶת־אַרְזֵ֥י הַלְּבָנֽוֹן׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 6,
     "end": 8,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 40,
     "end": 42,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "וַיַּרְקִידֵ֥ם כְּמוֹ־עֵ֑גֶל לְבָנ֥וֹן וְ֝שִׂרְיֹ֗ן כְּמ֣וֹ בֶן־רְאֵמִֽים׃",
   "names": []
  },
  {
   "v": 7,
   "text": "קוֹל־ה' חֹצֵ֗ב לַהֲב֥וֹת אֵֽשׁ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 5,
     "end": 7,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "ק֣וֹל ה' יָחִ֣יל מִדְבָּ֑ר יָחִ֥יל ה' מִדְבַּ֥ר קָדֵֽשׁ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 6,
     "end": 8,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 5,
     "start": 35,
     "end": 37,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 9,
   "text": "ק֤וֹל ה' ׀ יְחוֹלֵ֣ל אַיָּלוֹת֮ וַֽיֶּחֱשֹׂ֢ף יְעָ֫ר֥וֹת וּבְהֵיכָל֑וֹ כֻּ֝לּ֗וֹ אֹמֵ֥ר כָּבֽוֹד׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 6,
     "end": 8,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 10,
   "text": "ה' לַמַּבּ֣וּל יָשָׁ֑ב וַיֵּ֥שֶׁב ה' מֶ֣לֶךְ לְעוֹלָֽם׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 4,
     "start": 34,
     "end": 36,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "ה' עֹ֭ז לְעַמּ֣וֹ יִתֵּ֑ן ה' ׀ יְבָרֵ֖ךְ אֶת־עַמּ֣וֹ בַשָּׁלֽוֹם׃",
   "names": [
    {
     "type": "HAVAYAH",
