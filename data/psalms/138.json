 "verses": [
  {
   "v": 1,
   "text": "לְדָוִ֨ד ׀ אוֹדְךָ֥ בְכׇל־לִבִּ֑י נֶ֖גֶד אֱ-לֹהִ֣ים אֲזַמְּרֶֽךָּ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 5,
     "start": 41,
     "end": 51,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "אֶשְׁתַּחֲוֶ֨ה אֶל־הֵיכַ֪ל קׇדְשְׁךָ֡ וְא֘וֹדֶ֤ה אֶת־שְׁמֶ֗ךָ עַל־חַסְדְּךָ֥ וְעַל־אֲמִתֶּ֑ךָ כִּֽי־הִגְדַּ֥לְתָּ עַל־כׇּל־שִׁ֝מְךָ֗ אִמְרָתֶֽךָ׃",
   "names": []
  },
  {
   "v": 3,
   "text": "בְּי֣וֹם קָ֭רָֽאתִי וַֽתַּעֲנֵ֑נִי תַּרְהִבֵ֖נִי בְנַפְשִׁ֣י עֹֽז׃",
   "names": []
  },
  {
   "v": 4,
   "text": "יוֹד֣וּךָ ה' כׇּל־מַלְכֵי־אָ֑רֶץ כִּ֥י שָׁ֝מְע֗וּ אִמְרֵי־פִֽיךָ׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 1,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 5,
   "text": "וְ֭יָשִׁירוּ בְּדַרְכֵ֣י ה' כִּֽי־גָ֝ד֗וֹל כְּב֣וֹד ה'׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 25,
     "end": 27,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "HAVAYAH",
     "word": 6,
     "start": 52,
     "end": 54,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 6,
   "text": "כִּי־רָ֣ם ה' וְשָׁפָ֣ל יִרְאֶ֑ה וְ֝גָבֹ֗הַּ מִמֶּרְחָ֥ק יְיֵדָֽע׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 10,
     "end": 12,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 7,
   "text": "אִם־אֵלֵ֤ךְ ׀ בְּקֶ֥רֶב צָרָ֗ה תְּחַ֫יֵּ֥נִי עַ֤ל אַ֣ף אֹ֭יְבַי תִּשְׁלַ֣ח יָדֶ֑ךָ וְת֖וֹשִׁיעֵ֣נִי יְמִינֶֽךָ׃",
   "names": []
  },
  {
   "v": 8,
   "text": "ה' יִגְמֹ֢ר בַּ֫עֲדִ֥י ה' חַסְדְּךָ֣ לְעוֹלָ֑ם מַעֲשֵׂ֖י יָדֶ֣יךָ אַל־תֶּֽרֶף׃",
   "names": [
