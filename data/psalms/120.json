 "verse_count": 7,
 "verses": [
  {
   "v": 1,
   "text": "שִׁ֗יר הַֽמַּ֫עֲל֥וֹת אֶל־ה' בַּצָּרָ֣תָה לִּ֑י קָ֝רָ֗אתִי וַֽיַּעֲנֵֽנִי׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 3,
     "start": 26,
     "end": 28,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 2,
   "text": "ה' הַצִּ֣ילָה נַ֭פְשִׁי מִשְּׂפַת־שֶׁ֑קֶר מִלָּשׁ֥וֹן רְמִיָּֽה׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 0,
     "start": 0,
     "end": 2,
     "prefix": "",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "מַה־יִּתֵּ֣ן לְ֭ךָ וּמַה־יֹּסִ֥יף לָ֗ךְ לָשׁ֥וֹן רְמִיָּֽה׃",
   "names": []
  },
  {
   "v": 4,
   "text": "חִצֵּ֣י גִבּ֣וֹר שְׁנוּנִ֑ים עִ֝֗ם גַּחֲלֵ֥י רְתָמִֽים׃",
   "names": []
  },
  {
   "v": 5,
   "text": "אֽוֹיָה־לִ֭י כִּי־גַ֣רְתִּי מֶ֑שֶׁךְ שָׁ֝כַ֗נְתִּי עִֽם־אׇהֳלֵ֥י קֵדָֽר׃",
   "names": []
  },
  {
   "v": 6,
   "text": "רַ֭בַּת שָֽׁכְנָה־לָּ֣הּ נַפְשִׁ֑י עִ֝֗ם שׂוֹנֵ֥א שָׁלֽוֹם׃",
   "names": []
  },
  {
   "v": 7,
   "text": "אֲֽנִי־שָׁ֭לוֹם וְכִ֣י אֲדַבֵּ֑ר הֵ֝֗מָּה לַמִּלְחָמָֽה׃",
   "names": []
  }
 ],
