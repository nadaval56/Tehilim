 "verses": [
  {
   "v": 1,
   "text": "לַמְנַצֵּ֥חַ בִּנְגִינֹ֑ת מִזְמ֖וֹר לְאָסָ֣ף שִֽׁיר׃",
   "names": []
  },
  {
   "v": 2,
   "text": "נוֹדָ֣ע בִּיהוּדָ֣ה אֱ-לֹהִ֑ים בְּ֝יִשְׂרָאֵ֗ל גָּד֥וֹל שְׁמֽוֹ׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 20,
     "end": 30,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 3,
   "text": "וַיְהִ֣י בְשָׁלֵ֣ם סוּכּ֑וֹ וּמְע֖וֹנָת֣וֹ בְצִיּֽוֹן׃",
   "names": []
  },
  {
   "v": 4,
   "text": "שָׁ֭מָּה שִׁבַּ֣ר רִשְׁפֵי־קָ֑שֶׁת מָגֵ֬ן וְחֶ֖רֶב וּמִלְחָמָ֣ה סֶֽלָה׃",
   "names": []
  },
  {
   "v": 5,
   "text": "נָ֭אוֹר אַתָּ֥ה אַדִּ֗יר מֵֽהַרְרֵי־טָֽרֶף׃",
   "names": []
  },
  {
   "v": 6,
   "text": "אֶשְׁתּֽוֹלְל֨וּ ׀ אַבִּ֣ירֵי לֵ֭ב נָמ֣וּ שְׁנָתָ֑ם וְלֹֽא־מָצְא֖וּ כׇל־אַנְשֵׁי־חַ֣יִל יְדֵיהֶֽם׃",
   "names": []
  },
  {
   "v": 7,
   "text": "מִ֭גַּעֲרָ֣תְךָ אֱ-לֹהֵ֣י יַעֲקֹ֑ב נִ֝רְדָּ֗ם וְרֶ֣כֶב וָסֽוּס׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 1,
     "start": 16,
     "end": 25,
     "prefix": "",
     "suffix": "י",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 8,
   "text": "אַתָּ֤ה ׀ נ֥וֹרָא אַ֗תָּה וּמִֽי־יַעֲמֹ֥ד לְפָנֶ֗יךָ מֵאָ֥ז אַפֶּֽךָ׃",
   "names": []
  },
  {
   "v": 9,
   "text": "מִ֭שָּׁמַיִם הִשְׁמַ֣עְתָּ דִּ֑ין אֶ֖רֶץ יָֽרְאָ֣ה וְשָׁקָֽטָה׃",
   "names": []
  },
  {
   "v": 10,
   "text": "בְּקוּם־לַמִּשְׁפָּ֥ט אֱ-לֹהִ֑ים לְהוֹשִׁ֖יעַ כׇּל־עַנְוֵי־אֶ֣רֶץ סֶֽלָה׃",
   "names": [
    {
     "type": "ELOKIM",
     "word": 2,
     "start": 22,
     "end": 32,
     "prefix": "",
     "suffix": "ים",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 11,
   "text": "כִּֽי־חֲמַ֣ת אָדָ֣ם תּוֹדֶ֑ךָּ שְׁאֵרִ֖ית חֵמֹ֣ת תַּחְגֹּֽר׃",
   "names": []
  },
  {
   "v": 12,
   "text": "נִ֥דְר֣וּ וְשַׁלְּמוּ֮ לַה' אֱֽ-לֹהֵ֫יכֶ֥ם כׇּל־סְבִיבָ֑יו יֹבִ֥ילוּ שַׁ֝֗י לַמּוֹרָֽא׃",
   "names": [
    {
     "type": "HAVAYAH",
     "word": 2,
     "start": 23,
     "end": 27,
     "prefix": "ל",
     "suffix": "",
     "chol": false,
     "ktiv": false,
     "counted": true
    },
    {
     "type": "ELOKIM",
     "word": 3,
     "start": 28,
     "end": 42,
     "prefix": "",
     "suffix": "יכם",
     "chol": false,
     "ktiv": false,
     "counted": true
    }
   ]
  },
  {
   "v": 13,
   "text": "יִ֭בְצֹר ר֣וּחַ נְגִידִ֑ים נ֝וֹרָ֗א לְמַלְכֵי־אָֽרֶץ׃",
   "names": []
  }
 ],
