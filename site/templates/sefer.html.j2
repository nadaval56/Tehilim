{% extends "base.html.j2" %}
{% from "_map.html.j2" import book_map %}
{% block title %}מבנה ספר תהילים — חמשת הספרים, המחברים וסוגי המזמורים | {{ site.name }}{% endblock %}
{% block description %}חמשת הספרים שבספר תהילים, המחברים לפי הכותרות ולפי חז"ל, וסוגי המזמורים לפי לשון הכותרות.{% endblock %}
{% macro src_quote(s) %}
<blockquote class="source-quote">
  {% for seg in s.segments %}{{ seg.text }}{% if not loop.last %} {% endif %}{% endfor %}
  <cite>{{ s.title }} · <a href="{{ s.url }}">ספריא</a>, {{ s.version }} ({{ s.license }}){% if 'Vocalized' in s.version %}; הניקוד הוסר{% endif %}</cite>
</blockquote>
{% endmacro %}
{% block content %}
<section class="read">
  <h1>מבנה הספר</h1>
  <p>ספר תהילים נחלק לחמישה ספרים. כאן מוצגים החלוקה, המחברים והסוגים, כפי שהם עולים מלשון הכתוב ומדברי חז"ל. בחרו ממד כדי לצבוע את המפה ולראות את הנתונים שלו.</p>
</section>

{% call book_map(cells, root, [('book', 'ספר'), ('author', 'מחבר לפי הכותרת'), ('type', 'סוג לפי הכותרת'), ('alpha', 'על סדר האלף־בית')], 'book', AUTHOR_LEGEND, TYPE_LEGEND, BOOK_NAMES) %}
<section class="dim-panel" data-for="book" aria-label="נתונים לפי ספר">
  <h3>מזמורים בכל ספר</h3>
  {{ charts.book }}
  <h3>פסוקים בכל ספר</h3>
  {{ charts.book_verses }}
  <p class="note">{% for b in books %}{{ BOOK_NAMES[b.n] }}: מזמורים {{ b.first|heb }}–{{ b.last|heb }}{% if not loop.last %} · {% endif %}{% endfor %}.</p>
<h3 id="numbering">על המספור</h3>
<p class="read">האתר משתמש בחלוקה המקובלת ל-150 מזמורים. יש מסורות שבהן החלוקה שונה. כך, למשל, בגמרא על מזמורים א–ב:</p>
{{ src_quote(sources.psalms_1_2) }}
</section>

<section class="dim-panel" data-for="alpha" id="alphabetic" aria-label="מזמורים על סדר האלף־בית" hidden>
<h3>מזמורים על סדר האלף־בית</h3>
<div class="table-wrap"><table>
  <thead><tr><th>מזמור</th><th>מבנה</th><th>אותיות שלא נמצאו בראשי הפסוקים</th></tr></thead>
  <tbody>
  {% for a in alpha %}
  <tr>
    <td><a href="{{ root }}mizmor/{{ a.n }}/">{{ a.n|heb }}</a></td>
    <td>{{ a.kind }}</td>
    <td>{% if a.missing is none %}<span class="muted">לא חושב (האותיות בראשי חצאי הפסוקים)</span>{% elif a.missing %}{{ a.missing|join(', ') }}{% else %}כל האותיות{% if a.verified %}, שמונה פסוקים לכל אחת{% endif %}{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="note">החישוב לפי האות הראשונה של כל פסוק, אחרי הכותרת.</p>
<h4>הנו"ן שאינה ב"תהלה לדוד" (קמה)</h4>
{{ src_quote(sources.ashrei_nun) }}
<p class="no-source">לאותיות החסרות במזמורים כה ו-לד: לא נמצא עדיין מקור בחומר שנשלף.</p>
</section>

<section class="dim-panel" data-for="author" id="authors" aria-label="נתונים לפי מחבר" hidden>
  <h3>מזמורים לפי המחבר שבכותרת</h3>
  {{ charts.author }}
  <p class="note">מי שנזכר בכותרת המזמור בלשון "ל..." (לדוד, לאסף וכו'), וכן ידותון, הנזכר בכותרות בלשון "לידותון" ו"על ידותון". מזמור שכותרתו מזכירה יותר מאחד נמנה תחת כל אחד מהם, ובמפה הוא נצבע לפי הראשון.</p>
  <h3 id="chazal">המחברים לפי חז"ל</h3>
  <p>הגמרא במסכת בבא בתרא מונה את מי שעל ידם נכתב הספר:</p>
  {{ src_quote(sources.ten_elders) }}
  <p>ובהמשך הסוגיה, על איתן האזרחי:</p>
  {{ src_quote(sources.eitan_avraham) }}
  <details>
    <summary>רשימת המזמורים לכל מחבר</summary>
    {% set att_names = ['דוד', 'בני קרח', 'אסף', 'משה', 'שלמה', 'הימן', 'איתן', 'ידותון'] %}
    <div class="table-wrap"><table>
      <thead><tr><th>בכותרת</th><th class="n">מזמורים</th><th>רשימה</th></tr></thead>
      <tbody>
      {% for a in att_names %}
        {% set ns = [] %}{% for n, p in psalms.items() if p.heading and a in p.heading.attribution %}{% set _ = ns.append(n) %}{% endfor %}
        <tr><td>{{ a }}</td><td class="n">{{ ns|length }}</td><td class="small">{% for n in ns %}<a href="{{ root }}mizmor/{{ n }}/">{{ n|heb }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
      {% endfor %}
      {% set ns = [] %}{% for n, p in psalms.items() if not p.heading or not p.heading.attribution %}{% set _ = ns.append(n) %}{% endfor %}
        <tr><td>ללא מחבר בכותרת</td><td class="n">{{ ns|length }}</td><td class="small">{% for n in ns %}<a href="{{ root }}mizmor/{{ n }}/">{{ n|heb }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
      </tbody>
    </table></div>
  </details>
</section>

<section class="dim-panel" data-for="type" id="types" aria-label="נתונים לפי סוג" hidden>
  <h3>מזמורים לפי כינוי הסוג שבכותרת</h3>
  {{ charts.type }}
  <p class="note">רק הכינויים שבכותרות עצמן. מזמור שכותרתו כוללת כמה כינויים (למשל "שיר מזמור") נמנה תחת כל אחד.</p>
  <details>
    <summary>רשימת המזמורים לכל כינוי</summary>
    {% set type_names = ['מזמור', 'שיר', 'שיר המעלות', 'משכיל', 'מכתם', 'תפלה', 'תהלה', 'שגיון'] %}
    <div class="table-wrap"><table>
      <thead><tr><th>כינוי</th><th class="n">מזמורים</th><th>רשימה</th></tr></thead>
      <tbody>
      {% for t in type_names %}
        {% set ns = [] %}{% for n, p in psalms.items() if p.heading and t in p.heading.types %}{% set _ = ns.append(n) %}{% endfor %}
        <tr><td>{{ t }}</td><td class="n">{{ ns|length }}</td><td class="small">{% for n in ns %}<a href="{{ root }}mizmor/{{ n }}/">{{ n|heb }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
  </details>
</section>
{% endcall %}

{% endblock %}
