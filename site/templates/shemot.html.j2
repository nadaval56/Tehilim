{% extends "base.html.j2" %}
{% from "_map.html.j2" import book_map %}
{% block title %}שמות הקודש בספר תהילים: פיזור ומזמורים כפולים | {{ site.name }}{% endblock %}
{% block description %}מניין שמות הקודש בכל מזמור ובכל ספר בתהילים, מפת חום של יחס השמות, והמזמורים הכפולים זה לצד זה.{% endblock %}
{% block content %}
{% set seg = stats.segments %}
{% set in_h, in_e = seg['42-83'].HAVAYAH, seg['42-83'].ELOKIM %}
{% set out_h, out_e = seg['rest'].HAVAYAH, seg['rest'].ELOKIM %}
<section class="read">
  <h1>השמות</h1>
  <p>מניין שמות הקודש בספר, לפי מזמור ולפי ספר. המספרים חושבו מהטקסט עצמו.</p>
</section>

<dl class="facts">
  <div class="fact"><dt>מזמורים מב–פג</dt><dd class="num">ה' {{ in_h }} · א-להים {{ in_e }}</dd></div>
  <div class="fact"><dt>שאר הספר</dt><dd class="num">ה' {{ out_h }} · א-להים {{ out_e }}</dd></div>
  <div class="fact"><dt>בכל הספר</dt><dd class="num">ה' {{ stats.totals.HAVAYAH }} · א-להים {{ stats.totals.ELOKIM }}</dd></div>
</dl>

<h2 id="heatmap">מפת חום: יחס בין שם הויה לא-להים</h2>
<p class="read muted small">כל תא הוא מזמור. כחול: רוב שם הויה; טרקוטה: רוב א-להים; ככל שהגוון עמוק יותר, הרוב גדול יותר. הנתונים המלאים בטבלה שבתחתית הדף.</p>
{{ book_map(cells, root, [('names', 'שמות'), ('book', 'ספר')], 'names', AUTHOR_LEGEND, TYPE_LEGEND, BOOK_NAMES, id='heat') }}

<h2 id="by-book">לפי ספרים</h2>
{% set W, rowh, lab = 640, 56, 96 %}
{% set scale = (W - lab - 60) / chart_max %}
<svg class="chart" style="direction: ltr" viewBox="0 0 {{ W }} {{ rowh * 5 + 30 }}" role="img" aria-labelledby="chart-t chart-d">
  <title id="chart-t">שם הויה וא-להים בכל אחד מחמשת הספרים</title>
  <desc id="chart-d">{% for b in stats.per_book %}{{ BOOK_NAMES[b.book] }}: ה' {{ b.counts.HAVAYAH }}, א-להים {{ b.counts.ELOKIM }}. {% endfor %}</desc>
  {% for b in stats.per_book %}
  {% set y = loop.index0 * rowh + 6 %}
  <text x="{{ W - 4 }}" y="{{ y + 24 }}" text-anchor="end">{{ BOOK_NAMES[b.book] }}</text>
  <rect class="bar-hav" x="{{ W - lab - b.counts.HAVAYAH * scale }}" y="{{ y + 4 }}" width="{{ b.counts.HAVAYAH * scale }}" height="18" rx="4"/>
  <text class="val" x="{{ W - lab - b.counts.HAVAYAH * scale - 6 }}" y="{{ y + 18 }}" text-anchor="end">{{ b.counts.HAVAYAH }}</text>
  <rect class="bar-elo" x="{{ W - lab - b.counts.ELOKIM * scale }}" y="{{ y + 26 }}" width="{{ b.counts.ELOKIM * scale }}" height="18" rx="4"/>
  <text class="val" x="{{ W - lab - b.counts.ELOKIM * scale - 6 }}" y="{{ y + 40 }}" text-anchor="end">{{ b.counts.ELOKIM }}</text>
  {% endfor %}
  <line class="grid" x1="{{ W - lab }}" x2="{{ W - lab }}" y1="0" y2="{{ rowh * 5 + 4 }}"/>
</svg>
<ul class="legend"><li><i style="background: var(--hav)"></i>שם הויה (ה')</li><li><i style="background: var(--elo)"></i>א-להים</li></ul>

<h3>כל השמות לפי ספר</h3>
<div class="table-wrap"><table class="compact">
  <thead><tr><th>שם</th>{% for b in stats.per_book %}<th class="n" title="{{ BOOK_NAMES[b.book] }}">{{ b.book|heb }}'</th>{% endfor %}<th class="n">סה"כ</th></tr></thead>
  <tbody>
  {% for t in kinuyim.types %}
  <tr><td>{{ NAME_SHORT[t] }}</td>{% for b in stats.per_book %}<td class="n">{{ b.counts[t] }}</td>{% endfor %}<td class="n"><b>{{ stats.totals[t] }}</b></td></tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="note">העמודות הן חמשת הספרים (א' עד ה').</p>

<h2 id="doublets">מזמורים כפולים</h2>
<p class="read">קטעים שמופיעים בספר פעמיים, כמעט מילה במילה. בדף של כל זוג הם מוצגים זה לצד זה, וההבדלים מודגשים.</p>
<div class="cards">
  {% for pr in pairs %}
  <a class="card lens-card" href="{{ root }}kfulim/{{ pr.id }}/">
    <h3>{{ pr.title }}</h3>
    <p class="num">ה' {{ pr.count_a.HAVAYAH }}/{{ pr.count_b.HAVAYAH }} · א-להים {{ pr.count_a.ELOKIM }}/{{ pr.count_b.ELOKIM }}</p>
  </a>
  {% endfor %}
</div>
<h3>קטעים מקבילים נוספים שנמצאו חישובית</h3>
<p class="note">פסוקים רצופים שדומים זה לזה לפחות ב-70%, כשכל שם נחשב שווה לכל שם. עמדו על שורה או לחצו על "השוואה" כדי לראות את שני הקטעים זה לצד זה, עם הדגשת ההבדלים.</p>
<div class="table-wrap"><table class="cmp-table">
  <thead><tr><th>מקום א</th><th>מקום ב</th><th class="n">פסוקים</th><th class="n">דמיון</th><th><span class="visually-hidden">השוואה</span></th></tr></thead>
  <tbody>
  {% for r in cand_cmp %}
  {% set la %}{{ r.a|heb }}:{{ r.a_from|heb }}{% if r.a_to != r.a_from %}–{{ r.a_to|heb }}{% endif %}{% endset %}
  {% set lb %}{{ r.b|heb }}:{{ r.b_from|heb }}{% if r.b_to != r.b_from %}–{{ r.b_to|heb }}{% endif %}{% endset %}
  <tr class="cmp-row">
    <td><a href="{{ root }}mizmor/{{ r.a }}/#v{{ r.a_from }}">{{ la }}</a></td>
    <td><a href="{{ root }}mizmor/{{ r.b }}/#v{{ r.b_from }}">{{ lb }}</a></td>
    <td class="n">{{ r.verses }}</td><td class="n">{{ (r.mean_similarity * 100)|round|int }}%</td>
    <td><button type="button" class="cmp-btn" aria-expanded="false" aria-controls="cmp-pop">השוואה</button>
      <template class="cmp-tpl">
        <div class="cmp-col"><h4>תהילים {{ la }}</h4><p>{{ r.html_a }}</p></div>
        <div class="cmp-col"><h4>תהילים {{ lb }}</h4><p>{{ r.html_b }}</p></div>
      </template>
    </td>
  </tr>
  {% endfor %}
  </tbody>
</table></div>
<div id="cmp-pop" class="cmp-pop" role="dialog" aria-label="השוואת הקטעים" hidden>
  <button type="button" class="cmp-x" aria-label="סגירה">×</button>
  <div class="cmp-body"></div>
  <p class="cmp-legend small"><span class="diff">הבדל</span> <span class="diff-name-HAVAYAH">שם הויה</span> <span class="diff-name-ELOKIM">א-להים</span></p>
</div>
<script>
  (function () {
    var pop = document.getElementById('cmp-pop'), body = pop.querySelector('.cmp-body');
    var current = null, pinned = false;
    function place(row) {
      var r = row.getBoundingClientRect();
      if (window.innerWidth < 640) { pop.style.left = '8px'; pop.style.right = '8px'; pop.style.width = ''; pop.style.top = ''; pop.style.bottom = '8px'; return; }
      pop.style.right = ''; pop.style.bottom = '';
      var w = Math.min(760, window.innerWidth - 32);
      pop.style.width = w + 'px';
      pop.style.left = Math.max(16, (window.innerWidth - w) / 2) + 'px';
      var top = r.bottom + 6;
      if (top + pop.offsetHeight > window.innerHeight - 8) top = Math.max(8, r.top - pop.offsetHeight - 6);
      pop.style.top = top + 'px';
    }
    function show(row, pin) {
      if (current && current !== row) current.querySelector('.cmp-btn').setAttribute('aria-expanded', 'false');
      current = row; pinned = !!pin;
      body.innerHTML = row.querySelector('.cmp-tpl').innerHTML;
      pop.hidden = false; document.body.classList.add('cmp-open'); place(row);
      row.querySelector('.cmp-btn').setAttribute('aria-expanded', String(pinned));
    }
    function hide() {
      pop.hidden = true; pinned = false; document.body.classList.remove('cmp-open');
      if (current) current.querySelector('.cmp-btn').setAttribute('aria-expanded', 'false');
      current = null;
    }
    document.querySelectorAll('.cmp-row').forEach(function (row) {
      row.addEventListener('mouseenter', function () { if (!pinned && window.matchMedia('(hover: hover)').matches) show(row, false); });
      row.addEventListener('mouseleave', function (e) { if (!pinned && !pop.contains(e.relatedTarget)) hide(); });
      var btn = row.querySelector('.cmp-btn');
      btn.addEventListener('click', function () {
        if (pinned && current === row) { hide(); btn.focus(); } else { show(row, true); pop.querySelector('.cmp-x').focus(); }
      });
    });
    pop.addEventListener('mouseleave', function (e) { if (!pinned && !(current && current.contains(e.relatedTarget))) hide(); });
    pop.querySelector('.cmp-x').addEventListener('click', function () { var b = current && current.querySelector('.cmp-btn'); hide(); if (b) b.focus(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !pop.hidden) { var b = current && current.querySelector('.cmp-btn'); hide(); if (b) b.focus(); } });
    window.addEventListener('scroll', function () { if (current && !pop.hidden) place(current); }, { passive: true });
  })();
</script>

<h2 id="table">הנתונים לכל מזמור</h2>
<div class="table-wrap"><table class="compact">
  <thead><tr><th>מזמור</th><th class="n">ה'</th><th class="n">א-להים</th><th>שמות נוספים</th></tr></thead>
  <tbody>
  {% for r in stats.per_psalm %}
  <tr><td><a href="{{ root }}mizmor/{{ r.n }}/">{{ r.n|heb }}</a></td><td class="n">{{ r.counts.HAVAYAH or '' }}</td><td class="n">{{ r.counts.ELOKIM or '' }}</td>
    <td class="small">{% for t, c in r.counts.items() if t not in ('HAVAYAH', 'ELOKIM') and c %}{{ NAME_SHORT[t] }} {{ c }}{% if not loop.last %} · {% endif %}{% endfor %}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
{% endblock %}
