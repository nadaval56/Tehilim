{% extends "base.html.j2" %}
{% block title %}תהילים בחיים היהודיים: שיר של יום, קבלת שבת, הלל ועוד | {{ site.name }}{% endblock %}
{% block description %}המזמורים שנאמרים בתפילה ובמועדים, כל סדר ברצף אחד: שיר של יום, קבלת שבת, הלל, פסוקי דזמרה, תיקון חצות, התיקון הכללי ועוד.{% endblock %}
{% block content %}
<section class="read">
  <h1>תהילים בחיים היהודיים</h1>
  <p>המזמורים שנאמרים בתפילה, בשבת ובמועדים. לחיצה על סדר פותחת את כל המזמורים שבו ברצף, בסדר שבו הם נאמרים.</p>
</section>
<ul class="collection-grid">
  {% for c in collections %}
  <li><a class="collection-btn" href="{{ root }}tefila/{{ c.slug }}/">
    <span class="c-title">{{ c.title }}</span>
    <span class="c-meta">{% if c.days %}מזמור לכל יום{% else %}{{ c.count }} {{ 'מזמור' if c.count == 1 else 'מזמורים' }}{% endif %}{% if c.by_nusach and c.by_nusach[0].nusach and not c.same_everywhere %} · לפי נוסח{% endif %}</span>
  </a></li>
  {% endfor %}
</ul>
<div class="summary-box read">
  הרשימות נבנו מהסידורים שבספריא (אשכנז, ספרד ועדות המזרח): ממבנה הסידור ומהקישורים שבו לספר תהילים. שיר של יום לפי משנה תמיד, והתיקון הכללי לפי שיחות הר"ן.
</div>
{% endblock %}
